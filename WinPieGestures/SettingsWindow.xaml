                              </StackPanel>
                            </Grid>

                            <!-- 3. 参数专属配置区 -->
                            <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,10">
                              <StackPanel>
                                <!-- A. 快捷热键 -->
                                <StackPanel Visibility="{Binding IsHotkeyType, Converter={StaticResource BoolToVis}}">
                                  <TextBlock Text="快捷按键组合:" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4" />
                                  <Grid>
                                    <Grid.ColumnDefinitions>
                                      <ColumnDefinition Width="*" />
                                      <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <local:HotkeyRecorderBox Height="32" FontSize="11.5" HotkeyText="{Binding Parameter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <Button Grid.Column="1" Content="⚙️ 拼装..." Height="32" Padding="10,0" Margin="6,0,0,0" Style="{StaticResource ModernButtonStyle}" Click="CancelBuildHotkey_Click" ToolTip="打开快捷键组合拼装器" />
                                  </Grid>
                                </StackPanel>

                                <!-- B. 启动程序 -->
                                <StackPanel Visibility="{Binding IsLaunchType, Converter={StaticResource BoolToVis}}">
