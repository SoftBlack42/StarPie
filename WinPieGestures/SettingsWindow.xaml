                              <TextBlock Name="CancelActionStatusHint" Grid.Column="1" Text="💡 外甩脱离轮盘时，立即执行此自定义动作；回到轮盘中心仍为静默关闭。" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="10,0,0,0" TextWrapping="Wrap" />
