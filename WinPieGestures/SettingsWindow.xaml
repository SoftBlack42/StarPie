                            <!-- 1. 外甩高频极速预设芯片 -->
                            <StackPanel Margin="0,0,0,12">
                              <TextBlock Text="⚡ 外甩高频极速预设 (一键秒选):" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AccentPrimaryBrush}" Margin="0,0,0,6" />
                              <WrapPanel>
                                <Button Content="🖥️ 显示桌面 (Win+D)" Style="{StaticResource ModernButtonStyle}" Height="26" Padding="8,0" Margin="0,0,6,6" FontSize="11" Click="CancelPresetDesktop_Click" ToolTip="外甩快速显示桌面，查阅文件或切换任务" />
                                <Button Content="📑 任务视图 (Win+Tab)" Style="{StaticResource ModernButtonStyle}" Height="26" Padding="8,0" Margin="0,0,6,6" FontSize="11" Click="CancelPresetTaskView_Click" ToolTip="外甩浏览多虚拟桌面与所有活动任务窗口" />
                                <Button Content="↩️ 取消/返回 (Esc)" Style="{StaticResource ModernButtonStyle}" Height="26" Padding="8,0" Margin="0,0,6,6" FontSize="11" Click="CancelPresetEsc_Click" ToolTip="外甩退出当前弹窗或中断当前操作" />
                                <Button Content="✂️ 系统截屏 (Win+Shift+S)" Style="{StaticResource ModernButtonStyle}" Height="26" Padding="8,0" Margin="0,0,6,6" FontSize="11" Click="CancelPresetSnipping_Click" ToolTip="外甩快速唤起 Windows 区域截屏工具" />
                                <Button Content="🪟 左右对半平铺" Style="{StaticResource ModernButtonStyle}" Height="26" Padding="8,0" Margin="0,0,6,6" FontSize="11" Click="CancelPresetTile_Click" ToolTip="外甩将当前窗口以左右对半形式快速分屏" />
                                <Button Content="⚙️ StarPie 控制台" Style="{StaticResource ModernButtonStyle}" Height="26" Padding="8,0" Margin="0,0,6,6" FontSize="11" Click="CancelPresetSettings_Click" ToolTip="外甩呼出 StarPie 配置控制台界面" />
                              </WrapPanel>
                            </StackPanel>

                            <!-- 2. 动作类型选择与名称 -->
                            <Grid Margin="0,0,0,10">
                              <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220" />
                                <ColumnDefinition Width="*" />
                              </Grid.ColumnDefinitions>
                              <StackPanel Margin="0,0,8,0">
                                <TextBlock Text="动作类型 (7大精简分类):" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4" />
                                <ComboBox Height="32" FontSize="11.5" ItemsSource="{Binding AggregatedActionTypes}" SelectedValuePath="Tag" DisplayMemberPath="DisplayText" SelectedValue="{Binding AggregatedType, Mode=TwoWay}" Style="{StaticResource FlatComboBoxStyle}" />
                              </StackPanel>
                              <StackPanel Grid.Column="1">
                                <TextBlock Text="动作显示名称:" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4" />
