                                  <Grid>
                                    <Grid.ColumnDefinitions>
                                      <ColumnDefinition Width="*" />
                                      <ColumnDefinition Width="Auto" />
                                      <ColumnDefinition Width="Auto" />
                                      <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Text="{Binding Parameter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Height="32" FontSize="11" VerticalContentAlignment="Center" />
                                    <Button Grid.Column="1" Content="📦 软件库选择..." Height="32" Padding="8,0" Margin="4,0,0,0" Style="{StaticResource ModernButtonStyle}" Click="CancelPickProgramFromLibrary_Click" ToolTip="从已安装软件与开始菜单中选择" />
                                    <Button Grid.Column="2" Content="🎯 捕捉运行窗口..." Height="32" Padding="8,0" Margin="4,0,0,0" Style="{StaticResource ModernButtonStyle}" Click="CancelCaptureRunningWindow_Click" ToolTip="从桌面正在运行的程序中选择或拖拽准星瞄准抓取" />
                                    <Button Grid.Column="3" Content="📂 浏览..." Height="32" Padding="8,0" Margin="4,0,0,0" Style="{StaticResource ModernButtonStyle}" Click="GestureBrowse_Click" ToolTip="打开文件浏览窗口选择可执行文件" />
                                  </Grid>
                                </StackPanel>

                                <!-- C. 打开网址 -->
                                <StackPanel Visibility="{Binding IsWebUrlType, Converter={StaticResource BoolToVis}}">
                                  <TextBlock Text="目标网址 URL:" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4" />
                                  <TextBox Text="{Binding Parameter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Height="32" FontSize="11.5" VerticalContentAlignment="Center" Margin="0,0,0,6" />
                                  <WrapPanel>
                                    <TextBlock Text="常用网址:" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,6,0" />
