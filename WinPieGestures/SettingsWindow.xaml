                  </Grid>
                </StackPanel>
              </Border>
              <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="20" Margin="0,0,0,14" SnapsToDevicePixels="True" UseLayoutRounding="True" RenderOptions.ClearTypeHint="Enabled">
                <UIElement.Effect>
                  <DropShadowEffect BlurRadius="12" ShadowDepth="1" Color="#000000" Opacity="0.03" />
                </UIElement.Effect>
                <StackPanel>
                  <TextBlock Name="OuterEscapeTitleText" Text="顺势外甩脱离取消 (Outer Escape Cancel)" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                  <TextBlock Name="OuterEscapeDescText" Text="手势划出后若想放弃，无需拉回中心，直接顺势向外快速划出即可安全取消，0 误触。" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,10" TextWrapping="Wrap" />
                  <CheckBox Name="EnableOuterEscapeCheckBox" AutomationProperties.AutomationId="EnableOuterEscapeCheckBox" Style="{StaticResource ToggleSwitchStyle}" Margin="0,4,0,4" Checked="OuterEscapeCheckBox_Checked" Unchecked="OuterEscapeCheckBox_Unchecked">
                    <StackPanel Margin="6,0,0,0">
                      <TextBlock Name="OuterEscapeCheckboxTitleText" Text="启用向外顺势甩出取消手势 (推荐开启)" FontWeight="Medium" Foreground="{DynamicResource TextPrimaryBrush}" />
                      <TextBlock Name="OuterEscapeCheckboxDescText" Text="超过轮盘外圈范围后立即解除高亮，松开右键 0 误触安全放弃。" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" />
                    </StackPanel>
                  </CheckBox>
                  <StackPanel Name="OuterEscapeDistancePanel" Margin="0,10,0,0" Visibility="Collapsed">
                    <Border BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,1,0,0" Padding="0,12,0,0">
                      <StackPanel>
                        <TextBlock Name="OuterEscapeDistanceTitleText" Text="外甩取消距离灵敏度 (Escape Distance):" FontSize="12" FontWeight="Medium" Foreground="{DynamicResource TextPrimaryBrush}" />
                        <TextBlock Name="OuterEscapeDistanceDescText" Text="设定光标划出距离中心多远时触发安全取消。数值越小越灵敏（更易甩出取消），数值越大越沉稳（需甩得更远）。" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,8" TextWrapping="Wrap" />
                        <Grid Margin="0,2,0,0">
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="70" />
                          </Grid.ColumnDefinitions>
                          <Slider Name="OuterEscapeDistanceSlider" AutomationProperties.AutomationId="OuterEscapeDistanceSlider" Minimum="120" Maximum="650" Value="190" TickFrequency="5" IsSnapToTickEnabled="True" VerticalAlignment="Center" ValueChanged="OuterEscapeDistanceSlider_ValueChanged" />
                          <TextBlock Name="OuterEscapeDistanceLabel" Grid.Column="1" Text="190 px" FontWeight="Bold" Foreground="{DynamicResource AccentPrimaryBrush}" FontSize="13" HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>
                      </StackPanel>
                    </Border>
                  </StackPanel>
                  <Border Name="Tab0_CancelActionOuterBorder" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,1,0,0" Padding="0,12,0,0">
