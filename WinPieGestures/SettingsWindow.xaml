                  </Grid>

                  <!-- 折叠详细调节面板：关闭开关时默认折叠收纳 -->
                  <StackPanel Name="EdgeCollisionDetailsPanel" Margin="0,14,0,0" Visibility="Collapsed">
                    <Border BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,1,0,0" Padding="0,12,0,0">
                      <StackPanel>
                        <!-- 防溢出处理策略 -->
                        <Grid Margin="0,0,0,14">
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="220" />
                          </Grid.ColumnDefinitions>
                          <StackPanel VerticalAlignment="Center" Margin="0,0,10,0">
                            <TextBlock Text="防溢出处理策略 (Policy):" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Text="智能贴边：自动推入屏幕并对齐光标；屏幕中心：直接在当前显示器正中展现。" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" TextWrapping="Wrap" />
                          </StackPanel>
                          <ComboBox Name="EdgeOverflowPolicyComboBox" Grid.Column="1" Style="{StaticResource FlatComboBoxStyle}" Height="34" VerticalAlignment="Center" SelectionChanged="EdgeOverflowPolicyComboBox_SelectionChanged">
                            <ComboBoxItem Tag="ClampShift" Content="🛡️ 智能贴边防溢出 (推荐)" />
                            <ComboBoxItem Tag="ScreenCenter" Content="🎯 屏幕物理正中心呼出" />
                            <ComboBoxItem Tag="None" Content="🚫 原生跟随光标 (允许溢出)" />
                          </ComboBox>
                        </Grid>

                        <!-- X轴区域调节滑块 (水平安全边距) -->
