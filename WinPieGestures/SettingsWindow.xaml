                    </Border>
                    <Border Background="{DynamicResource SubtleCardBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,10,0,0">
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="Auto" />
                          <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="💡" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Top" />
                        <TextBlock Name="CoreImagePerformanceTipText" Grid.Column="1" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" LineHeight="16" Text="提示：推荐使用 256×256 ~ 512×512 适中分辨率的图片或 SVG 矢量图。中心文字与轮盘扇区文字已完全解耦，可分别自定义色彩与字体。" />
                      </Grid>
                    </Border>
                  </StackPanel>
                </Border>

                <!-- 卡片 5：轮盘层数切换提示微标定制 (仅高级全量模式展示) -->
                <Border Name="Tab1_LayerIndicatorCardBorder" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="18" Margin="0,12,0,0">
                  <UIElement.Effect>
                    <DropShadowEffect BlurRadius="12" ShadowDepth="1" Color="#000000" Opacity="0.03" />
                  </UIElement.Effect>
                  <StackPanel>
                    <TextBlock Name="LayerIndicatorSectionTitle" Text="轮盘层数切换提示微标 (Layer Switch Indicator)" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,8" />
                    <TextBlock Name="LayerIndicatorSectionDesc" Text="在高级全量模式下呼出轮盘后，滑动滚轮或按快捷键切换多层轮盘时的浮动提示徽标外观与停留时长。" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,10" />

                    <!-- 提示显示总开关 -->
                    <CheckBox Name="ShowLayerIndicatorCheckBox" Content="启用层数切换浮动提示徽标 (Show Layer Indicator)" Style="{StaticResource ToggleSwitchStyle}" Margin="0,0,0,10" Checked="ShowLayerIndicatorCheckBox_Changed" Unchecked="ShowLayerIndicatorCheckBox_Changed" />

                    <StackPanel Name="LayerIndicatorConfigPanel" Visibility="Visible">
                      <!-- 预设外观风格 -->
                      <TextBlock Name="LayerIndicatorStyleTitleText" Text="徽标预设风格 (Preset Style):" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4" />
                      <ComboBox Name="LayerIndicatorStyleComboBox" Style="{StaticResource FlatComboBoxStyle}" Height="34" Margin="0,0,0,10" SelectionChanged="LayerIndicatorStyleComboBox_SelectionChanged">
                        <ComboBoxItem Content="🌌 沉浸深邃暗黑 (Dark Slate - 推荐)" Tag="Dark" IsSelected="True" />
                        <ComboBoxItem Content="🧊 晶莹极光蓝透 (Aurora Cyan)" Tag="Aurora" />
                        <ComboBoxItem Content="🔮 钛金晶透曜紫 (Titanium Purple)" Tag="Purple" />
                        <ComboBoxItem Content="⚪ 极简透白浅色 (Minimalist Light)" Tag="Light" />
                        <ComboBoxItem Content="🔘 跟随当前轮盘主题 (Follow Wheel Theme)" Tag="FollowTheme" />
                        <ComboBoxItem Content="🎨 完全自定义色彩 (Custom Hex)" Tag="Custom" />
                      </ComboBox>

                      <!-- 前置图标选择 -->
                      <TextBlock Name="LayerIndicatorIconTitleText" Text="提示前置图标 (Indicator Icon):" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4" />
                      <ComboBox Name="LayerIndicatorIconComboBox" Style="{StaticResource FlatComboBoxStyle}" Height="34" Margin="0,0,0,10" SelectionChanged="LayerIndicatorIconComboBox_SelectionChanged">
                        <ComboBoxItem Content="🌟 璀璨星芒 (Star - 默认)" Tag="🌟" IsSelected="True" />
                        <ComboBoxItem Content="❄️ 冰晶雪花 (Snowflake)" Tag="❄️" />
                        <ComboBoxItem Content="🌀 宇宙星盘 (Galaxy Orbit)" Tag="🌀" />
                        <ComboBoxItem Content="⚡ 极速闪电 (Lightning)" Tag="⚡" />
                        <ComboBoxItem Content="🎯 准星靶心 (Target)" Tag="🎯" />
                        <ComboBoxItem Content="💎 纯净宝石 (Diamond)" Tag="💎" />
                        <ComboBoxItem Content="🚫 无前置图标 (仅文字)" Tag="None" />
                      </ComboBox>

                      <!-- 自定义颜色设置区 -->
                      <Border Name="LayerIndicatorCustomColorBorder" Background="{DynamicResource SubtleCardBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,10">
                        <StackPanel>
                          <TextBlock Text="🎨 徽标色彩微调 (十六进制色值 / 调色盘 / 屏幕吸色):" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,8" />

                          <!-- 徽标底色 -->
                          <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="68" />
                              <ColumnDefinition Width="*" />
                              <ColumnDefinition Width="Auto" />
                              <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="徽标底色:" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                            <TextBox Name="LayerIndicatorBgTextBox" Grid.Column="1" Height="28" Margin="0,0,6,0" TextChanged="LayerIndicatorColorTextBox_TextChanged" />
                            <Button Grid.Column="2" Width="28" Height="28" Padding="0" Margin="0,0,4,0" ToolTip="打开调色板选取颜色" Tag="LayerIndicatorBg" Style="{StaticResource ModernButtonStyle}" Click="PickCustomColor_Click">
                              <Border Name="LayerIndicatorBgPreview" Width="20" Height="20" CornerRadius="3" BorderBrush="{DynamicResource InputBorderBrush}" BorderThickness="1" />
                            </Button>
                            <Button Grid.Column="3" Content="🔍" Width="28" Height="28" Padding="0" ToolTip="从屏幕任意位置吸取颜色" Tag="LayerIndicatorBg" Style="{StaticResource ModernButtonStyle}" Click="PickEyedropper_Click" />
                          </Grid>

                          <!-- 边框颜色 -->
                          <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="68" />
                              <ColumnDefinition Width="*" />
                              <ColumnDefinition Width="Auto" />
                              <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="边框颜色:" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                            <TextBox Name="LayerIndicatorBorderTextBox" Grid.Column="1" Height="28" Margin="0,0,6,0" TextChanged="LayerIndicatorColorTextBox_TextChanged" />
                            <Button Grid.Column="2" Width="28" Height="28" Padding="0" Margin="0,0,4,0" ToolTip="打开调色板选取颜色" Tag="LayerIndicatorBorder" Style="{StaticResource ModernButtonStyle}" Click="PickCustomColor_Click">
                              <Border Name="LayerIndicatorBorderPreview" Width="20" Height="20" CornerRadius="3" BorderBrush="{DynamicResource InputBorderBrush}" BorderThickness="1" />
                            </Button>
                            <Button Grid.Column="3" Content="🔍" Width="28" Height="28" Padding="0" ToolTip="从屏幕任意位置吸取颜色" Tag="LayerIndicatorBorder" Style="{StaticResource ModernButtonStyle}" Click="PickEyedropper_Click" />
                          </Grid>

                          <!-- 文字与图标颜色 -->
                          <Grid Margin="0,0,0,2">
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="68" />
                              <ColumnDefinition Width="*" />
                              <ColumnDefinition Width="Auto" />
                              <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="文字色彩:" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                            <TextBox Name="LayerIndicatorTextTextBox" Grid.Column="1" Height="28" Margin="0,0,6,0" TextChanged="LayerIndicatorColorTextBox_TextChanged" />
                            <Button Grid.Column="2" Width="28" Height="28" Padding="0" Margin="0,0,4,0" ToolTip="打开调色板选取颜色" Tag="LayerIndicatorText" Style="{StaticResource ModernButtonStyle}" Click="PickCustomColor_Click">
                              <Border Name="LayerIndicatorTextPreview" Width="20" Height="20" CornerRadius="3" BorderBrush="{DynamicResource InputBorderBrush}" BorderThickness="1" />
                            </Button>
                            <Button Grid.Column="3" Content="🔍" Width="28" Height="28" Padding="0" ToolTip="从屏幕任意位置吸取颜色" Tag="LayerIndicatorText" Style="{StaticResource ModernButtonStyle}" Click="PickEyedropper_Click" />
                          </Grid>
                        </StackPanel>
                      </Border>

                      <!-- 尺寸与形态滑块 -->
                      <TextBlock Name="LayerIndicatorCornerRadiusTitleText" Text="徽标平滑圆角 (Corner Radius):" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
                      <Grid Margin="0,2,0,8">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="45" />
                        </Grid.ColumnDefinitions>
                        <Slider Name="LayerIndicatorCornerRadiusSlider" Minimum="4" Maximum="24" Value="12" TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center" ValueChanged="LayerIndicatorSlider_ValueChanged" />
                        <TextBlock Name="LayerIndicatorCornerRadiusLabel" Grid.Column="1" Text="12 px" FontWeight="Bold" Foreground="{DynamicResource AccentPrimaryBrush}" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center" />
                      </Grid>

                      <TextBlock Name="LayerIndicatorFontSizeTitleText" Text="文字字号大小 (Font Size):" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
                      <Grid Margin="0,2,0,8">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="45" />
                        </Grid.ColumnDefinitions>
                        <Slider Name="LayerIndicatorFontSizeSlider" Minimum="9" Maximum="16" Value="11.5" SmallChange="0.5" LargeChange="1.0" TickFrequency="0.5" IsSnapToTickEnabled="True" VerticalAlignment="Center" ValueChanged="LayerIndicatorSlider_ValueChanged" />
                        <TextBlock Name="LayerIndicatorFontSizeLabel" Grid.Column="1" Text="11.5 px" FontWeight="Bold" Foreground="{DynamicResource AccentPrimaryBrush}" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center" />
                      </Grid>

                      <TextBlock Name="LayerIndicatorOffsetYTitleText" Text="垂直显示位置偏移 (Offset Y):" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
                      <Grid Margin="0,2,0,8">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="45" />
                        </Grid.ColumnDefinitions>
                        <Slider Name="LayerIndicatorOffsetYSlider" Minimum="0" Maximum="60" Value="10" TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center" ValueChanged="LayerIndicatorSlider_ValueChanged" />
                        <TextBlock Name="LayerIndicatorOffsetYLabel" Grid.Column="1" Text="10 px" FontWeight="Bold" Foreground="{DynamicResource AccentPrimaryBrush}" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center" />
                      </Grid>

                      <TextBlock Name="LayerIndicatorDurationTitleText" Text="提示淡出停留时间 (Duration):" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
                      <Grid Margin="0,2,0,10">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="50" />
                        </Grid.ColumnDefinitions>
                        <Slider Name="LayerIndicatorDurationSlider" Minimum="400" Maximum="3000" Value="1200" SmallChange="100" LargeChange="200" TickFrequency="100" IsSnapToTickEnabled="True" VerticalAlignment="Center" ValueChanged="LayerIndicatorSlider_ValueChanged" />
                        <TextBlock Name="LayerIndicatorDurationLabel" Grid.Column="1" Text="1.2 s" FontWeight="Bold" Foreground="{DynamicResource AccentPrimaryBrush}" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center" />
                      </Grid>

                      <Button Name="ResetLayerIndicatorButton" Content="🔄 恢复默认提示徽标样式" Style="{StaticResource ModernButtonStyle}" Height="30" Padding="12,0" HorizontalAlignment="Left" Cursor="Hand" Margin="0,2,0,0" Click="ResetLayerIndicatorButton_Click" />
                    </StackPanel>
                  </StackPanel>
                </Border>
              </StackPanel>
            </ScrollViewer>
            <Border Grid.Column="1" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="18">
              <UIElement.Effect>
                <DropShadowEffect BlurRadius="12" ShadowDepth="1" Color="#000000" Opacity="0.03" />
              </UIElement.Effect>
              <Grid>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="*" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Margin="0,0,0,8">
                  <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="实时交互画布 (Live Preview)" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                    <Border Grid.Column="1" Background="#ECFDF5" CornerRadius="4" Padding="6,2">
                      <TextBlock Text="60FPS 同步渲染" FontSize="10" FontWeight="Bold" Foreground="#059669" />
                    </Border>
                  </Grid>
                  <TextBlock Text="💡 移动鼠标至下方轮盘可实时测试高亮与磁吸手感" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" />

                  <Border Name="LivePreviewTierSegmentBorder" Background="{DynamicResource SubtleCardBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="3" Margin="0,6,0,2">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <RadioButton Name="Tier1ConfigSegmentRadio" Content="🔘 一级主轮盘配置" GroupName="ConfigTierSegmentGroup" IsChecked="True" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Height="28" Cursor="Hand" FontWeight="SemiBold" Checked="TierDimensionRadio_Checked" />
                      <RadioButton Name="Tier2ConfigSegmentRadio" Grid.Column="1" Content="🌟 二级级联轮盘配置" GroupName="ConfigTierSegmentGroup" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Height="28" Cursor="Hand" FontWeight="SemiBold" Checked="TierDimensionRadio_Checked" />
                    </Grid>
                  </Border>
                </StackPanel>
                <Border Grid.Row="1" Background="{DynamicResource PreviewCanvasBackgroundBrush}" BorderBrush="{DynamicResource PreviewCanvasBorderBrush}" BorderThickness="1" CornerRadius="10" ClipToBounds="True" Margin="0,4,0,10">
                  <Grid Name="PreviewViewportContainer" ClipToBounds="True" Background="Transparent" MouseWheel="PreviewViewport_MouseWheel" MouseDown="PreviewViewport_MouseDown" MouseMove="PreviewViewport_MouseMove" MouseUp="PreviewViewport_MouseUp">
                    <Path Stroke="{DynamicResource PreviewGridLineBrush}" StrokeThickness="0.5" Data="M0,150 L300,150 M150,0 L150,300" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" />
                    
                    <!-- 画布实时预览：层级提示徽标 -->
                    <Border Name="PreviewLayerIndicatorBadge" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,10,0,0" Background="#E60F172A" BorderBrush="#38BDF8" BorderThickness="1.2" CornerRadius="12" Padding="12,4" IsHitTestVisible="False">
                      <Border.Effect>
                        <DropShadowEffect BlurRadius="8" ShadowDepth="1" Color="#000000" Opacity="0.4" />
                      </Border.Effect>
                      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Name="PreviewLayerIndicatorIcon" Text="🌟" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center" />
                        <TextBlock Name="PreviewLayerIndicatorText" Text="第 2 层 (2/2)" FontSize="11.5" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center" />
                      </StackPanel>
                    </Border>

                    <Canvas Name="LiveWheelPreviewCanvas" Width="300" Height="300" HorizontalAlignment="Center" VerticalAlignment="Center" MouseMove="LiveWheelPreviewCanvas_MouseMove" MouseLeave="LiveWheelPreviewCanvas_MouseLeave">
                      <Canvas.RenderTransform>
                        <TransformGroup>
                          <ScaleTransform x:Name="PreviewScaleTransform" ScaleX="1.0" ScaleY="1.0" CenterX="150" CenterY="150" />
                          <TranslateTransform x:Name="PreviewTranslateTransform" X="0" Y="0" />
                        </TransformGroup>
                      </Canvas.RenderTransform>
                    </Canvas>
                    <!-- 视口缩放与平移悬浮工具栏 -->
                    <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,8,8,0" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="3,2">
                      <Border.Effect>
                        <DropShadowEffect BlurRadius="8" ShadowDepth="1" Color="#000000" Opacity="0.12" />
                      </Border.Effect>
                      <StackPanel Orientation="Horizontal">
                        <Button Name="PreviewZoomOutBtn" Content="➖" ToolTip="缩小视图 (或使用鼠标滚轮)" Style="{StaticResource CanvasToolBtnStyle}" FontSize="10" Click="PreviewZoomOutBtn_Click" />
                        <TextBlock Name="PreviewZoomLabel" Text="100%" Width="38" TextAlignment="Center" VerticalAlignment="Center" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Cursor="Hand" ToolTip="点击复位为 100%" MouseLeftButtonDown="PreviewZoomLabel_MouseLeftButtonDown" />
                        <Button Name="PreviewZoomInBtn" Content="➕" ToolTip="放大视图 (或使用鼠标滚轮)" Style="{StaticResource CanvasToolBtnStyle}" FontSize="10" Click="PreviewZoomInBtn_Click" />
                        <Border Width="1" Height="14" Background="{DynamicResource CardBorderBrush}" Margin="3,0" VerticalAlignment="Center" />
                        <Button Name="PreviewResetViewBtn" Content="🎯" ToolTip="重置视图位置与缩放 (双击画布空白处也可复位)" Style="{StaticResource CanvasToolBtnStyle}" FontSize="11" Click="PreviewResetViewBtn_Click" />
                      </StackPanel>
                    </Border>
                    <!-- 左下角操作提示 -->
                    <TextBlock Name="PreviewPanHintText" Text="💡 鼠标中键/右键拖拽平移 / 滚轮缩放 / 双击复位" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="8,0,0,6" IsHitTestVisible="False" Opacity="0.75" />
                  </Grid>
                </Border>
                <Button Name="ResetDimensionsButton" Grid.Row="2" Content="一键重置为推荐几何尺寸" Style="{StaticResource ModernButtonStyle}" Height="32" HorizontalAlignment="Right" Click="ResetDimensionsButton_Click" />
              </Grid>
            </Border>
          </Grid>
        </Grid>
        <Grid Name="MappingsSettingsGrid" Visibility="Collapsed">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          
          <!-- 顶部标题栏与视图切换器 -->
          <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
              <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Name="GesturesPageHeader" Text="手势方向与动作映射" FontSize="19" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />

                <!-- 紧凑型多层轮盘管理工具栏 (仅高级全量模式展示，移至标题右侧留白处) -->
                <Border Name="Tab2_MultiLayerHeaderPanel" VerticalAlignment="Center" Margin="14,0,0,0" HorizontalAlignment="Left" Background="{DynamicResource SubtleCardBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="5,2">
                  <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="🌀 轮盘层:" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" Margin="3,0,5,0" />
                    <ComboBox Name="LayerSelectComboBox" Style="{StaticResource FlatComboBoxStyle}" Height="25" Width="95" VerticalAlignment="Center" DisplayMemberPath="Name" SelectionChanged="LayerSelectComboBox_SelectionChanged" />
                    <Button Name="AddLayerBtn" Content="➕ 加层" Style="{StaticResource ModernButtonStyle}" Height="24" Padding="5,0" Margin="4,0,2,0" ToolTip="新增一层独立轮盘配置（支持无限多层）" Click="AddLayerBtn_Click" />
                    <Button Name="CopyLayerBtn" Content="📑 复制" Style="{StaticResource ModernButtonStyle}" Height="24" Padding="5,0" Margin="0,0,2,0" ToolTip="复制当前层的所有扇区动作与中心核圆到新层" Click="CopyLayerBtn_Click" />
                    <Button Name="RenameLayerBtn" Content="✏️" Style="{StaticResource ModernButtonStyle}" Height="24" Padding="5,0" Margin="0,0,2,0" ToolTip="重命名当前轮盘层" Click="RenameLayerBtn_Click" />
                    <Button Name="DeleteLayerBtn" Content="🗑️" Style="{StaticResource ModernButtonStyle}" Height="24" Padding="5,0" Margin="0,0,2,0" ToolTip="删除当前轮盘层（至少保留一层）" Click="DeleteLayerBtn_Click" />
                    <Border Width="1" Height="12" Background="{DynamicResource CardBorderBrush}" Margin="4,0" VerticalAlignment="Center" />
                    <TextBlock Name="LayerSwitchTriggerLabel" Text="🔄 切换:" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="2,0,4,0" />
                    <ComboBox Name="LayerSwitchTriggerComboBox" Style="{StaticResource FlatComboBoxStyle}" Height="25" Width="108" VerticalAlignment="Center" ToolTip="多层轮盘切换方式：支持鼠标滚轮上下滑动切换或 Tab 键循环切换" SelectionChanged="LayerSwitchTriggerComboBox_SelectionChanged">
                      <ComboBoxItem Content="🖱️ 滚轮切换" Tag="Wheel" />
                      <ComboBoxItem Content="⌨️ Tab 键切换" Tag="Tab" />
                    </ComboBox>
                  </StackPanel>
                </Border>
              </StackPanel>

              <TextBlock Name="GesturesPageSubheader" Text="支持针对不同前台应用程序设置专属的多向手势轮盘、按键动作、中心核圆与级联子动作。" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0" />
            </StackPanel>

            <!-- 视图模式分段切换 (画布联动精调 vs 紧凑全览列表) -->
            <Border Name="Tab2_MappingsViewModeBorder" Grid.Column="1" Background="{DynamicResource SubtleCardBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="3" VerticalAlignment="Center">
              <StackPanel Orientation="Horizontal">
                <RadioButton Name="MappingsViewModeCanvasRadio" GroupName="MappingsViewModeGroup" Content="🎯 画布联动精调 (推荐)" Style="{StaticResource ModernSegmentRadioButtonStyle}" IsChecked="True" Checked="MappingsViewMode_Checked" />
                <RadioButton Name="MappingsViewModeListRadio" GroupName="MappingsViewModeGroup" Content="📋 紧凑全览列表" Style="{StaticResource ModernSegmentRadioButtonStyle}" Margin="4,0,0,0" Checked="MappingsViewMode_Checked" />
              </StackPanel>
            </Border>
          </Grid>

          <!-- 模式 1：画布联动精调工作区 (MappingsCanvasModeGrid) -->
          <Grid Name="MappingsCanvasModeGrid" Grid.Row="1" Visibility="Visible">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Name="Tab2LeftColumn" Width="1.15*" MinWidth="340" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Name="Tab2RightColumn" Width="1*" MinWidth="340" />
            </Grid.ColumnDefinitions>

            <!-- 左栏：方案工具卡片 + 聚焦精调卡片 (Focus Editor Card) -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,12,32">
              <StackPanel>
                <!-- 卡片 1：方案选择与管理卡片 -->
                <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="14" Margin="0,0,0,12">
                  <Grid>
                    <Grid.RowDefinitions>
                      <RowDefinition Height="Auto" />
                      <RowDefinition Height="Auto" />
                      <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    
                    <Grid Grid.Row="0" Margin="0,0,0,8">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <TextBlock Text="当前配置方案:" VerticalAlignment="Center" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,10,0" />
                      <ComboBox Name="MappingsProfileComboBox" Grid.Column="1" MinWidth="130" Style="{StaticResource FlatComboBoxStyle}" Height="30" DisplayMemberPath="DisplayTitle" SelectionChanged="MappingsProfileComboBox_SelectionChanged" VerticalAlignment="Center" />
                      
                      <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                        <Button Name="DuplicateProfileBtn" Content="📑 复制方案" Style="{StaticResource ModernButtonStyle}" Height="28" Padding="8,0" Margin="0,0,4,0" ToolTip="将当前方案的所有动作与多层配置复制为新程序方案" Click="DuplicateProfileBtn_Click" />
                        <Button Name="AddProfileBtn2" Content="➕ 新增" Style="{StaticResource ModernButtonStyle}" Height="28" Padding="8,0" Margin="0,0,4,0" ToolTip="添加新的轮盘配置方案（点击可选择从程序添加、捕捉窗口或自定义命名）" Click="AddProfileBtn2_Click">
                          <Button.ContextMenu>
                            <ContextMenu Style="{StaticResource ModernContextMenuStyle}">
                              <MenuItem Header="🖥️ 从已安装软件中添加 (专属程序配置)..." Style="{StaticResource ModernMenuItemStyle}" Click="AddProfileButton_Click" />
                              <MenuItem Header="🎯 捕捉运行中窗口添加 (专属程序配置)..." Style="{StaticResource ModernMenuItemStyle}" Click="AddProfileByCapture_Click" />
                              <MenuItem Header="📁 浏览本地程序文件添加 (.exe / .lnk)..." Style="{StaticResource ModernMenuItemStyle}" Click="AddProfileByBrowse_Click" />
                              <MenuItem Header="✏️ 新建自定义名称方案 (工作流/模式配置)..." Style="{StaticResource ModernMenuItemStyle}" Click="AddCustomProfileButton_Click" />
                            </ContextMenu>
                          </Button.ContextMenu>
                        </Button>
                        <Button Name="RenameProfileBtn2" Content="✏️ 重命名" Style="{StaticResource ModernButtonStyle}" Height="28" Padding="8,0" Margin="0,0,4,0" ToolTip="重命名选中的配置方案" Click="RenameProfileButton_Click" />
                        <Button Name="DeleteProfileBtn2" Content="🗑️" Style="{StaticResource ModernButtonStyle}" Height="28" Padding="8,0" ToolTip="删除当前选中的配置方案" Click="DeleteProfileButton_Click" />
                      </StackPanel>
                    </Grid>

                    <!-- 程序情景绑定卡片 (Profile Context Binding Card) -->
                    <Border Name="ProfileBindingCardBorder" Grid.Row="1" Background="{DynamicResource WindowBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,0,8">
                      <StackPanel>
                        <!-- 1. Global 模式说明 -->
                        <Grid Name="ProfileGlobalHintPanel">
                          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="🌐" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="全局通用基础方案：当活动前台程序未配置专属轮盘时，手势将自动应用此全局方案。" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                          </StackPanel>
                        </Grid>

                        <!-- 2. 专属程序模式绑定面板 -->
                        <StackPanel Name="ProfileCustomBindingPanel" Visibility="Collapsed">
                          <Grid>
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="Auto" />
                              <ColumnDefinition Width="*" />
                              <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="🎯 绑定程序情景:" VerticalAlignment="Center" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,8,0" />
                            <TextBox Name="ProfileBoundProcessesTextBox" Grid.Column="1" Height="28" FontSize="11" VerticalContentAlignment="Center" ToolTip="目标程序进程名（如 photoshop.exe 或 code.exe）。支持以英文逗号分隔多个进程。" TextChanged="ProfileBoundProcessesTextBox_TextChanged" />
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0,0,0">
                              <Button Name="ProfileCaptureWindowBtn" Content="🎯 捕捉窗口..." Style="{StaticResource ModernButtonStyle}" Height="28" Padding="8,0" Margin="0,0,4,0" ToolTip="直接点击桌面上运行中的目标软件窗口，自动识别并绑定其进程" Click="ProfileCaptureWindowBtn_Click" />
                              <Button Name="ProfilePickProgramBtn" Content="🖥️ 软件库..." Style="{StaticResource ModernButtonStyle}" Height="28" Padding="8,0" Margin="0,0,4,0" ToolTip="从已安装的软件列表中选择程序并绑定" Click="ProfilePickProgramBtn_Click" />
                              <Button Name="ProfileBrowseExeBtn" Content="📁 浏览..." Style="{StaticResource ModernButtonStyle}" Height="28" Padding="8,0" ToolTip="浏览选取本地可执行程序文件 (.exe / .lnk)" Click="ProfileBrowseExeBtn_Click" />
                            </StackPanel>
                          </Grid>
                          <TextBlock Text="💡 提示：在此程序处于前台活跃状态时唤起轮盘将自动应用本方案。支持以英文逗号分隔多个进程名 (例如 chrome.exe, msedge.exe)。" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" Margin="0,4,0,0" TextWrapping="Wrap" />

                          <!-- per-app 唤醒触发键（可选）：为 null 时跟随全局「触发与场景」 -->
                          <Border Name="ProfileTriggerCardBorder" Margin="0,10,0,0" Background="{DynamicResource SubtleCardBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10,8">
                            <StackPanel>
                              <CheckBox Name="ProfileTriggerEnableCheckBox" Content="⚡ 为此软件单独设置唤醒键" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Checked="ProfileTriggerEnableCheckBox_Changed" Unchecked="ProfileTriggerEnableCheckBox_Changed" />
                              <TextBlock Name="ProfileTriggerTipText" Text="未单独设置时，此软件唤醒轮盘使用全局「触发与场景」的快捷按键。" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" Margin="0,3,0,0" TextWrapping="Wrap" />
                              <Grid Margin="0,6,0,0">
                                <Grid.ColumnDefinitions>
                                  <ColumnDefinition Width="*" />
                                  <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Background="{DynamicResource WindowBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="8,4" VerticalAlignment="Center" Margin="0,0,8,0">
                                  <TextBlock Name="ProfileTriggerBadgeText" Text="跟随全局" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                                </Border>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                  <Button Name="ProfileTriggerRecordBtn" Content="🔴 录制" Style="{StaticResource ModernButtonStyle}" Height="26" Padding="8,0" Margin="0,0,4,0" IsEnabled="False" Click="ProfileTriggerRecordBtn_Click" />
                                  <Button Name="ProfileTriggerClearBtn" Content="✖ 清除" Style="{StaticResource ModernButtonStyle}" Height="26" Padding="8,0" IsEnabled="False" Click="ProfileTriggerClearBtn_Click" />
                                </StackPanel>
                              </Grid>
                            </StackPanel>
                          </Border>
                        </StackPanel>
                      </StackPanel>
                    </Border>

                    <Border Grid.Row="2" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,1,0,0" Padding="0,8,0,0">
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="Auto" />
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="扇区方位数量:" VerticalAlignment="Center" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,12,0" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                          <RadioButton Name="MappingsSectorCount4Radio" GroupName="MappingsSectorCountGroup" Content="4 键十字方位" Margin="0,0,20,0" Checked="MappingsSectorCountRadio_Checked" />
                          <RadioButton Name="MappingsSectorCount8Radio" GroupName="MappingsSectorCountGroup" Content="8 键全向方位 (推荐)" Margin="0,0,20,0" IsChecked="True" Checked="MappingsSectorCountRadio_Checked" />
                          <RadioButton Name="MappingsSectorCount12Radio" GroupName="MappingsSectorCountGroup" Content="12 键钟表方位" Checked="MappingsSectorCountRadio_Checked" />
                        </StackPanel>
                        <CheckBox Name="EnableGlobalInheritanceCheckBox" Grid.Column="2" Content="🌐 继承全局方案未配置槽位" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" ToolTip="当专属程序方案中的某个扇区未配置动作时，自动级联继承并执行全局方案对应方位的动作" Checked="EnableGlobalInheritanceCheckBox_Changed" Unchecked="EnableGlobalInheritanceCheckBox_Changed" />
                      </Grid>
                    </Border>
                  </Grid>
                </Border>

                <!-- 卡片 2：动作聚焦精调卡片 (Focus Editor Card) -->
                <Border Name="FocusActionEditorBorder" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,0,12">
                  <StackPanel>
                    <StackPanel Name="FocusSingleSlotPanel">
                      <!-- 顶部槽位导航与微标 -->
                      <Grid Margin="0,0,0,12">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      
                      <!-- 槽位微标 -->
                      <Border Name="FocusSlotBadgeBorder" Grid.Column="0" Width="36" Height="36" CornerRadius="8" Background="{DynamicResource AccentPrimaryBrush}" Margin="0,0,10,0" VerticalAlignment="Center">
                        <TextBlock Name="FocusSlotBadgeText" Text="N" FontSize="13" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                      </Border>

                      <!-- 槽位标题与提示 -->
                      <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                          <TextBlock Name="FocusSlotTitleText" Text="扇区 1 [向上] (North)" FontSize="13.5" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,8,0" />
                          <Border Name="FocusSlotTagBorder" CornerRadius="4" Background="{DynamicResource NavTabActiveBgBrush}" Padding="6,2" VerticalAlignment="Center">
                            <TextBlock Name="FocusSlotTagText" Text="一级主扇区" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource AccentPrimaryBrush}" />
                          </Border>
                          <Border Name="FocusSlotInheritedBadge" Visibility="Collapsed" CornerRadius="4" Background="#183B82F6" BorderBrush="#803B82F6" BorderThickness="1" Padding="6,2" Margin="6,0,0,0" VerticalAlignment="Center" ToolTip="当前槽位在专属方案中未配置，已自动继承全局方案同向动作">
                            <TextBlock Text="🌐 全局继承" FontSize="10.5" FontWeight="SemiBold" Foreground="#3B82F6" />
                          </Border>
                        </StackPanel>
                        <TextBlock Name="FocusSlotSubtitleText" Text="点击右侧轮盘直接选中扇区，或使用右侧按钮切换槽位" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" />
                      </StackPanel>

                      <!-- 槽位导航按钮组 -->
                      <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Name="FocusBackToParentBtn" Content="◀ 返回父级扇区" Style="{StaticResource PrimaryButtonStyle}" Height="28" Padding="8,0" Margin="0,0,6,0" Visibility="Collapsed" Click="FocusBackToParentBtn_Click" />
                        <Button Name="FocusPrevSlotBtn" Content="◀ 上一槽" Style="{StaticResource ModernButtonStyle}" Height="28" Padding="8,0" Margin="0,0,4,0" Click="FocusPrevSlotBtn_Click" />
                        <Button Name="FocusNextSlotBtn" Content="下一槽 ▶" Style="{StaticResource ModernButtonStyle}" Height="28" Padding="8,0" Margin="0,0,4,0" Click="FocusNextSlotBtn_Click" />
                        <Button Name="FocusCenterCoreBtn" Content="🎯 中心核圆" Style="{StaticResource ModernButtonStyle}" Height="28" Padding="8,0" Click="FocusCenterCoreBtn_Click" />
                      </StackPanel>
                    </Grid>

                    <!-- 中心核心圆专属折叠状态条 (仅选中中心核圆时呈现，超紧凑设计) -->
                    <Border Name="FocusCenterCoreBanner" Visibility="Collapsed" Background="{DynamicResource SubtleCardBrush}" BorderBrush="{DynamicResource AccentPrimaryBrush}" BorderThickness="1" CornerRadius="8" Padding="8,6" Margin="0,0,0,12">
                      <StackPanel>
                        <!-- 单行状态栏 -->
                        <Grid>
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                          </Grid.ColumnDefinitions>
                          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <CheckBox Name="EnableCenterActionCheckBox" Content="启用中心核圆动作" Style="{StaticResource ToggleSwitchStyle}" Margin="0,0,10,0" Checked="EnableCenterActionCheckBox_Changed" Unchecked="EnableCenterActionCheckBox_Changed" />
                            <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                              <TextBlock Text="死区松开触发 · 外甩脱离取消" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" />
                            </Border>
                          </StackPanel>
                          <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Name="CenterPresetsToggleBtn" Content="⚡ 常用预设 ▾" Style="{StaticResource ModernButtonStyle}" Height="24" Padding="6,0" Margin="0,0,4,0" FontSize="11" Click="CenterPresetsToggleBtn_Click" />
                            <Button Name="CenterInfoToggleBtn" Content="ℹ️ 说明 ▾" Style="{StaticResource ModernButtonStyle}" Height="24" Padding="6,0" FontSize="11" Click="CenterInfoToggleBtn_Click" />
                          </StackPanel>
                        </Grid>

                        <!-- 自定义中心图案优先提示条 -->
                        <Border Name="CenterPatternPriorityTip" Visibility="Collapsed" Margin="0,6,0,0" Background="#18F59E0B" BorderBrush="#80F59E0B" BorderThickness="1" CornerRadius="6" Padding="8,5">
                          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="🎨" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="当前已启用自定义中心图案，轮盘中心将优先展示该图案；在中心死区内松开鼠标仍会照常触发本功能。" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" TextWrapping="Wrap" />
                          </StackPanel>
                        </Border>

                        <!-- 展开区 1：常用预设快速填入 -->
                        <StackPanel Name="CenterPresetsContainer" Visibility="Collapsed" Margin="0,8,0,0">
                          <Border BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,1,0,0" Padding="0,6,0,0">
                            <WrapPanel VerticalAlignment="Center">
                              <TextBlock Text="一键填入:" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,6,0" />
                              <Button Content="⚙️ 控制台" Style="{StaticResource ModernButtonStyle}" Height="24" Padding="6,0" Margin="0,0,4,4" FontSize="10.5" Click="ApplyCenterPreset_OpenSettings" />
                              <Button Content="🖥️ 显示桌面" Style="{StaticResource ModernButtonStyle}" Height="24" Padding="6,0" Margin="0,0,4,4" FontSize="10.5" Click="ApplyCenterPreset_Desktop" />
                              <Button Content="🔒 锁定屏幕" Style="{StaticResource ModernButtonStyle}" Height="24" Padding="6,0" Margin="0,0,4,4" FontSize="10.5" Click="ApplyCenterPreset_Lock" />
                              <Button Content="🌐 常用网站" Style="{StaticResource ModernButtonStyle}" Height="24" Padding="6,0" Margin="0,0,4,4" FontSize="10.5" Click="ApplyCenterPreset_WebUrl" />
                              <Button Content="📁 资源管理" Style="{StaticResource ModernButtonStyle}" Height="24" Padding="6,0" Margin="0,0,4,4" FontSize="10.5" Click="ApplyCenterPreset_Explorer" />
                            </WrapPanel>
                          </Border>
                        </StackPanel>

                        <!-- 展开区 2：机制说明 -->
                        <Border Name="CenterInfoContainer" Visibility="Collapsed" Margin="0,8,0,0" Background="{DynamicResource CardBackgroundBrush}" CornerRadius="6" Padding="8">
                          <TextBlock Text="💡 外甩脱离机制说明：开启「外甩脱离取消」后，手势若在中心内径死区内释放光标，将直接触发在此配置的动作（如呼出控制台、启动工具或热键）；若需废弃/取消手势，直接向外快速甩出轮盘边缘即可。" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
                        </Border>
                      </StackPanel>
                    </Border>

                    <!-- 暂无二级子动作提示卡片 (仅当切换至二级级联且未添加任何子动作时显示) -->
                    <Border Name="FocusTier2EmptyNoticeBorder" Visibility="Collapsed" Background="{DynamicResource SubtleCardBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="20,16" Margin="0,0,0,12">
                      <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="🌟 当前主扇区尚未配置二级级联子动作" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center" />
                        <TextBlock Text="向外划动此扇区时可展开二级子菜单。支持添加 1~4 个二级子动作。" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,4,0,12" />
                        <Button Content="➕ 添加第 1 个二级子动作" Style="{StaticResource PrimaryButtonStyle}" Height="32" Padding="16,0" HorizontalAlignment="Center" Click="FocusAddSubActionBtn_Click" />
                      </StackPanel>
                    </Border>

                    <!-- 模块 1：图标与显示名称配置 -->
                    <Border Name="FocusNameAndIconBorder" Background="{DynamicResource SubtleCardBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,12">
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="70" />
                          <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <!-- 图标选择按钮 -->
                        <Button Name="FocusPickIconButton" Grid.Column="0" Style="{StaticResource ModernButtonStyle}" Height="54" Padding="4" Margin="0,0,10,0" ToolTip="点击选取矢量图标或自定SVG" Click="FocusPickIcon_Click">
                          <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Image Name="FocusIconImage" Width="20" Height="20" Stretch="Uniform" HorizontalAlignment="Center" Margin="0,0,0,2" Visibility="Collapsed" />
                            <Path Name="FocusIconPath" Width="20" Height="20" Stretch="Uniform" Fill="{DynamicResource AccentPrimaryBrush}" HorizontalAlignment="Center" Margin="0,0,0,2" />
                            <TextBlock Name="FocusIconLabel" Text="图标..." FontSize="9.5" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" />
                          </StackPanel>
                        </Button>

                        <!-- 动作显示名称输入框 -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                          <TextBlock Name="FocusActionNameLabel" Text="轮盘显示文本 (Action Name):" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4" />
                          <TextBox Name="FocusActionNameTextBox" Height="30" FontSize="12" TextChanged="FocusActionNameTextBox_TextChanged" />
                        </StackPanel>
                      </Grid>
                    </Border>

                    <!-- 模块 2：触发动作类型选择与参数配置 -->
                    <Border Name="FocusActionTypeAndParamsBorder" Background="{DynamicResource SubtleCardBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,12">
                      <StackPanel>
                        <Grid Margin="0,0,0,10">
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                          </Grid.ColumnDefinitions>
                          <TextBlock Text="触发动作类型:" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,10,0" />
                          <ComboBox Name="FocusActionTypeComboBox" Grid.Column="1" Style="{StaticResource FlatComboBoxStyle}" Height="30" SelectedValuePath="Tag" DisplayMemberPath="DisplayText" SelectionChanged="FocusActionTypeComboBox_SelectionChanged" />
                          <Button Name="FocusRestoreInheritBtn" Grid.Column="2" Content="🌐 恢复继承全局" Style="{StaticResource ModernButtonStyle}" Height="30" Padding="8,0" Margin="8,0,0,0" Visibility="Collapsed" ToolTip="清除当前槽位的专属覆写，恢复继承全局方案对应方位的动作" Click="FocusRestoreInheritBtn_Click" />
                          <Button Name="FocusTestActionBtn" Grid.Column="3" Content="▶ 测试触发" Style="{StaticResource ModernButtonStyle}" Height="30" Padding="10,0" Margin="8,0,0,0" Click="FocusTestActionBtn_Click" />
                        </Grid>

                        <!-- 动态参数面板容器 -->
                        <!-- 1. 热键面板 -->
                        <StackPanel Name="FocusHotkeyPanel" Visibility="Visible">
                          <Grid>
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="*" />
                              <ColumnDefinition Width="Auto" />
                              <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <local:HotkeyRecorderBox x:Name="FocusHotkeyRecorder" Height="32" FontSize="12" />
                            <Button Name="TogglePauseHotkeysBtn" Grid.Column="1" Content="⏸️ 暂停全局热键" Style="{StaticResource ModernButtonStyle}" Height="32" Padding="8,0" Margin="6,0,0,0" ToolTip="暂停桌面系统及其他软件的所有全局快捷键，在此独占录入快捷键而不会触发系统（如 Win+D、Alt+Tab、截屏等）或其他软件" Click="TogglePauseHotkeysBtn_Click" />
                            <Button Grid.Column="2" Content="⚙️ 拼装组合" Style="{StaticResource ModernButtonStyle}" Height="32" Padding="8,0" Margin="6,0,0,0" Click="FocusHotkeyBuilder_Click" />
                          </Grid>
                        </StackPanel>

                        <!-- 2. 启动程序面板 -->
                        <StackPanel Name="FocusLaunchPanel" Visibility="Collapsed">
                          <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="*" />
                              <ColumnDefinition Width="Auto" />
                              <ColumnDefinition Width="Auto" />
                              <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Name="FocusLaunchPathTextBox" Height="30" FontSize="11.5" ToolTip="应用程序路径" TextChanged="FocusLaunchPathTextBox_TextChanged" />
                            <Button Grid.Column="1" Content="📦 软件库选择..." Style="{StaticResource ModernButtonStyle}" Height="30" Padding="8,0" Margin="6,0,0,0" ToolTip="从已安装的软件、微软商店与开始菜单中模糊搜索选取" Click="FocusPickProgramFromLibrary_Click" />
                            <Button Grid.Column="2" Content="🎯 捕捉运行窗口..." Style="{StaticResource ModernButtonStyle}" Height="30" Padding="8,0" Margin="6,0,0,0" ToolTip="直接探测并捕捉桌面上正在运行的活跃窗口与程序执行路径" Click="FocusCaptureRunningWindow_Click" />
                            <Button Grid.Column="3" Content="📂 浏览..." Style="{StaticResource ModernButtonStyle}" Height="30" Padding="8,0" Margin="6,0,0,0" ToolTip="手动浏览可执行文件或快捷方式" Click="FocusBrowseLaunchExe_Click" />
                          </Grid>
                          <Grid>
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="Auto" />
                              <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="启动参数:" VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,8,0" />
                            <TextBox Name="FocusLaunchArgsTextBox" Grid.Column="1" Height="28" FontSize="11" ToolTip="启动命令行参数 (可选)" TextChanged="FocusLaunchArgsTextBox_TextChanged" />
                          </Grid>
                          <CheckBox Name="FocusLaunchStandardUserCheckBox" Style="{StaticResource ToggleSwitchStyle}" Margin="0,6,0,0" Checked="FocusLaunchStandardUserCheckBox_Changed" Unchecked="FocusLaunchStandardUserCheckBox_Changed">
                            <StackPanel Margin="6,0,0,0">
                              <TextBlock Text="🛡️ 以常规普通权限启动 (解决高权限下外部文件无法拖入目标软件的问题)" FontSize="11" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" />
                              <TextBlock Text="当 StarPie 以管理员权限运行时，通过 Windows Shell 降权启动目标程序，恢复文件拖拽交互支持。" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                          </CheckBox>
                        </StackPanel>

                        <!-- 3. 打开网址面板 (WebUrl) -->
                        <StackPanel Name="FocusWebUrlPanel" Visibility="Collapsed">
                          <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="*" />
                              <ColumnDefinition Width="145" />
                            </Grid.ColumnDefinitions>
                            <TextBox Name="FocusWebUrlTextBox" Height="30" FontSize="11.5" ToolTip="目标网址，如 https://github.com" TextChanged="FocusWebUrlTextBox_TextChanged" />
                            <ComboBox Name="FocusWebBrowserComboBox" Grid.Column="1" Style="{StaticResource FlatComboBoxStyle}" Height="30" Margin="6,0,0,0" SelectionChanged="FocusWebBrowserComboBox_SelectionChanged">
                              <ComboBoxItem Tag="Default" Content="🌐 系统默认" IsSelected="True" />
                              <ComboBoxItem Tag="Chrome" Content="Google Chrome" />
                              <ComboBoxItem Tag="Edge" Content="Microsoft Edge" />
                              <ComboBoxItem Tag="Firefox" Content="Mozilla Firefox" />
                              <ComboBoxItem Tag="Custom" Content="自定义浏览器..." />
                            </ComboBox>
                          </Grid>
                          <StackPanel Name="FocusCustomBrowserPathPanel" Visibility="Collapsed" Margin="0,0,0,6">
                            <Grid>
                              <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                              </Grid.ColumnDefinitions>
                              <TextBox Name="FocusCustomBrowserPathTextBox" Height="28" FontSize="11" ToolTip="自定义浏览器可执行文件路径" TextChanged="FocusCustomBrowserPathTextBox_TextChanged" />
                              <Button Grid.Column="1" Content="📂 选择..." Style="{StaticResource ModernButtonStyle}" Height="28" Padding="8,0" Margin="6,0,0,0" Click="FocusBrowseCustomBrowser_Click" />
                            </Grid>
                          </StackPanel>
                          <!-- 常用网址快捷芯片 -->
                          <WrapPanel Margin="0,2,0,0">
                            <TextBlock Text="常用网址:" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <Button Content="GitHub" Style="{StaticResource ModernButtonStyle}" Height="22" Padding="6,0" Margin="0,0,4,2" FontSize="10" Click="ApplyUrlPreset_GitHub" />
                            <Button Content="Bilibili" Style="{StaticResource ModernButtonStyle}" Height="22" Padding="6,0" Margin="0,0,4,2" FontSize="10" Click="ApplyUrlPreset_Bilibili" />
                            <Button Content="Bing 搜索" Style="{StaticResource ModernButtonStyle}" Height="22" Padding="6,0" Margin="0,0,4,2" FontSize="10" Click="ApplyUrlPreset_Bing" />
                            <Button Content="Google" Style="{StaticResource ModernButtonStyle}" Height="22" Padding="6,0" Margin="0,0,4,2" FontSize="10" Click="ApplyUrlPreset_Google" />
                          </WrapPanel>
                        </StackPanel>

                        <!-- 4. 打开文件夹面板 -->
                        <StackPanel Name="FocusFolderPanel" Visibility="Collapsed">
                          <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="*" />
                              <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Name="FocusFolderPathTextBox" Height="30" FontSize="11.5" ToolTip="本地文件夹绝对路径" TextChanged="FocusFolderPathTextBox_TextChanged" />
                            <Button Grid.Column="1" Content="📂 浏览..." Style="{StaticResource ModernButtonStyle}" Height="30" Padding="8,0" Margin="6,0,0,0" Click="FocusBrowseFolder_Click" />
                          </Grid>
                          <!-- 文件夹预设 -->
                          <WrapPanel>
                            <TextBlock Text="常用目录:" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <Button Content="💻 此电脑" Style="{StaticResource ModernButtonStyle}" Height="22" Padding="6,0" Margin="0,0,4,2" FontSize="10" Click="ApplyFolderPreset_ThisPC" ToolTip="直接打开系统「此电脑」命名空间" />
                            <Button Content="🗑️ 回收站" Style="{StaticResource ModernButtonStyle}" Height="22" Padding="6,0" Margin="0,0,4,2" FontSize="10" Click="ApplyFolderPreset_RecycleBin" ToolTip="直接打开系统「回收站」命名空间" />
                            <Button Content="🖥️ 桌面" Style="{StaticResource ModernButtonStyle}" Height="22" Padding="6,0" Margin="0,0,4,2" FontSize="10" Click="ApplyFolderPreset_Desktop" />
                            <Button Content="📥 下载" Style="{StaticResource ModernButtonStyle}" Height="22" Padding="6,0" Margin="0,0,4,2" FontSize="10" Click="ApplyFolderPreset_Downloads" />
                            <Button Content="📄 文档" Style="{StaticResource ModernButtonStyle}" Height="22" Padding="6,0" Margin="0,0,4,2" FontSize="10" Click="ApplyFolderPreset_Documents" />
                          </WrapPanel>
                        </StackPanel>

                        <!-- 5. 命令行面板 -->
                        <StackPanel Name="FocusCommandPanel" Visibility="Collapsed">
                          <Grid>
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="*" />
                              <ColumnDefinition Width="110" />
                            </Grid.ColumnDefinitions>
                            <TextBox Name="FocusCommandTextBox" Height="30" FontSize="11.5" ToolTip="要执行的命令行语句，如 ping -t 127.0.0.1" TextChanged="FocusCommandTextBox_TextChanged" />
                            <ComboBox Name="FocusCommandTerminalComboBox" Grid.Column="1" Style="{StaticResource FlatComboBoxStyle}" Height="30" Margin="6,0,0,0" SelectedValuePath="Tag" DisplayMemberPath="DisplayText" SelectionChanged="FocusCommandTerminalComboBox_SelectionChanged" />
                          </Grid>
                        </StackPanel>

                        <!-- 6. 窗口管理面板 (WindowManager) -->
                        <StackPanel Name="FocusWindowManagerPanel" Visibility="Collapsed">
                          <!-- 子动作模式选择 -->
                          <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="Auto" />
                              <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="控制模式:" VerticalAlignment="Center" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,8,0" />
                            <ComboBox Name="FocusWindowSubModeComboBox" Grid.Column="1" Style="{StaticResource FlatComboBoxStyle}" Height="30" SelectionChanged="FocusWindowSubModeComboBox_SelectionChanged">
                              <ComboBoxItem Tag="Tile" Content="🔲 平铺窗口排布" />
                              <ComboBoxItem Tag="TileCycle" Content="🔄 循环切换平铺" />
                              <ComboBoxItem Tag="TileCycleBack" Content="⬅️ 反向循环平铺" />
                              <ComboBoxItem Tag="TileRestore" Content="⏪ 还原平铺快照" />
                              <ComboBoxItem Tag="ToggleTopmost" Content="📌 窗口置顶 / 取消置顶" />
                              <ComboBoxItem Tag="MoveMonitor" Content="🖥️ 移到下一显示器" />
                              <ComboBoxItem Tag="WindowOpacity" Content="👁️ 窗口透明度调节" />
                              <ComboBoxItem Tag="SwitchWindow" Content="🗂️ 任务栏切换 (Win+N)" />
                            </ComboBox>
                          </Grid>

                          <!-- 子模式 1: 平铺窗口排布 -->
                          <StackPanel Name="FocusWindowTileSubPanel" Visibility="Visible">
                            <Grid Margin="0,0,0,6">
                              <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                              </Grid.ColumnDefinitions>
                              <ComboBox Name="FocusTileLayoutComboBox" Style="{StaticResource FlatComboBoxStyle}" Height="30" SelectedValuePath="Tag" DisplayMemberPath="DisplayText" SelectionChanged="FocusTileLayoutComboBox_SelectionChanged" />
                              <Button Name="FocusPopulateTileSubActionsBtn" Grid.Column="1" Content="✨ 预设 8 布局二级轮盘" Style="{StaticResource ModernButtonStyle}" Height="30" Padding="8,0" Margin="6,0,0,0" ToolTip="自动在二级级联菜单中填充 8 种常用平铺布局" Click="FocusPopulateTileSubActions_Click" />
                            </Grid>
                            <!-- 常用平铺排布芯片快捷点选 -->
                            <WrapPanel Margin="0,2,0,0">
                              <TextBlock Text="常用布局:" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,6,0" />
                              <Button Content="左右对半 (2L)" Style="{StaticResource ModernButtonStyle}" Height="22" Padding="6,0" Margin="0,0,4,2" FontSize="10" Click="FocusTilePreset_2L" />
                              <Button Content="上下对半 (2T)" Style="{StaticResource ModernButtonStyle}" Height="22" Padding="6,0" Margin="0,0,4,2" FontSize="10" Click="FocusTilePreset_2T" />
                              <Button Content="左大列 (3L12)" Style="{StaticResource ModernButtonStyle}" Height="22" Padding="6,0" Margin="0,0,4,2" FontSize="10" Click="FocusTilePreset_3L12" />
                              <Button Content="四宫格 (4G)" Style="{StaticResource ModernButtonStyle}" Height="22" Padding="6,0" Margin="0,0,4,2" FontSize="10" Click="FocusTilePreset_4G" />
                              <Button Content="三等分 (3R)" Style="{StaticResource ModernButtonStyle}" Height="22" Padding="6,0" Margin="0,0,4,2" FontSize="10" Click="FocusTilePreset_3R" />
                            </WrapPanel>
                          </StackPanel>

                          <!-- 子模式 2: 循环/反向平铺 -->
                          <StackPanel Name="FocusWindowCycleSubPanel" Visibility="Collapsed" Margin="0,2,0,0">
                            <Border Background="{DynamicResource InputBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10,6">
                              <TextBlock Text="💡 触发手势时，自动在下方「平铺窗口设置」中勾选的排布列表中循环轮换下一个布局。" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
                            </Border>
                          </StackPanel>

                          <!-- 子模式 3: 还原平铺快照 -->
                          <StackPanel Name="FocusWindowRestoreSubPanel" Visibility="Collapsed" Margin="0,2,0,0">
                            <Border Background="{DynamicResource InputBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10,6">
                              <TextBlock Text="⏪ 还原所有窗口到平铺前的初始大小与屏幕坐标位置。" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
                            </Border>
                          </StackPanel>

                          <!-- 子模式 4: 窗口置顶 -->
                          <StackPanel Name="FocusWindowTopmostSubPanel" Visibility="Collapsed" Margin="0,2,0,0">
                            <Border Background="{DynamicResource InputBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10,6">
                              <TextBlock Text="📌 将当前鼠标所在窗口或前台活动窗口固定置顶于最前（再次触发即可恢复）。" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
                            </Border>
                          </StackPanel>

                          <!-- 子模式 5: 移到下一屏 -->
                          <StackPanel Name="FocusWindowMoveMonitorSubPanel" Visibility="Collapsed" Margin="0,2,0,0">
                            <Border Background="{DynamicResource InputBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10,6">
                              <TextBlock Text="🖥️ 将当前活动窗口移动至下一个物理显示器对应的工作区位置。" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
                            </Border>
                          </StackPanel>

                          <!-- 子模式 6: 窗口透明度 -->
                          <StackPanel Name="FocusWindowOpacitySubPanel" Visibility="Collapsed" Margin="0,2,0,0">
                            <Grid Margin="0,0,0,6">
                              <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="42" />
                              </Grid.ColumnDefinitions>
                              <TextBlock Text="不透明度:" VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,8,0" />
                              <Slider Name="FocusWindowOpacitySlider" Grid.Column="1" Minimum="30" Maximum="100" Value="80" SmallChange="5" LargeChange="10" VerticalAlignment="Center" ValueChanged="FocusWindowOpacitySlider_ValueChanged" />
                              <TextBlock Name="FocusWindowOpacityLabel" Grid.Column="2" Text="80%" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource AccentPrimaryBrush}" VerticalAlignment="Center" HorizontalAlignment="Right" />
                            </Grid>
                            <WrapPanel>
                              <TextBlock Text="快捷预设:" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,6,0" />
                              <Button Content="70% 极淡" Style="{StaticResource ModernButtonStyle}" Height="22" Padding="6,0" Margin="0,0,4,2" FontSize="10" Click="FocusOpacityPreset_70" />
                              <Button Content="80% 查阅" Style="{StaticResource ModernButtonStyle}" Height="22" Padding="6,0" Margin="0,0,4,2" FontSize="10" Click="FocusOpacityPreset_80" />
                              <Button Content="90% 透视" Style="{StaticResource ModernButtonStyle}" Height="22" Padding="6,0" Margin="0,0,4,2" FontSize="10" Click="FocusOpacityPreset_90" />
                              <Button Content="100% 不透明" Style="{StaticResource ModernButtonStyle}" Height="22" Padding="6,0" Margin="0,0,4,2" FontSize="10" Click="FocusOpacityPreset_100" />
                            </WrapPanel>
                          </StackPanel>

                          <!-- 子模式 7: 切换任务栏应用 -->
                          <StackPanel Name="FocusWindowSwitchSubPanel" Visibility="Collapsed" Margin="0,2,0,0">
                            <Grid Margin="0,0,0,6">
                              <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="70" />
                                <ColumnDefinition Width="*" />
                              </Grid.ColumnDefinitions>
                              <TextBlock Text="任务栏序号 (1~20):" VerticalAlignment="Center" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,8,0" />
                              <TextBox Name="FocusWindowSwitchTextBox" Grid.Column="1" Height="30" FontSize="12" TextAlignment="Center" TextChanged="FocusWindowSwitchTextBox_TextChanged" />
                              <TextBlock Grid.Column="2" Text="等同快捷键 Win + 序号" FontSize="10.5" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" Margin="8,0,0,0" />
                            </Grid>
                            <WrapPanel>
                              <TextBlock Text="快速选择:" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,6,0" />
                              <Button Content="#1 槽位" Style="{StaticResource ModernButtonStyle}" Height="22" Padding="6,0" Margin="0,0,4,2" FontSize="10" Click="FocusSwitchPreset_1" />
                              <Button Content="#2 槽位" Style="{StaticResource ModernButtonStyle}" Height="22" Padding="6,0" Margin="0,0,4,2" FontSize="10" Click="FocusSwitchPreset_2" />
                              <Button Content="#3 槽位" Style="{StaticResource ModernButtonStyle}" Height="22" Padding="6,0" Margin="0,0,4,2" FontSize="10" Click="FocusSwitchPreset_3" />
                              <Button Content="#4 槽位" Style="{StaticResource ModernButtonStyle}" Height="22" Padding="6,0" Margin="0,0,4,2" FontSize="10" Click="FocusSwitchPreset_4" />
                            </WrapPanel>
                          </StackPanel>
                        </StackPanel>

                        <!-- 7. 系统动作面板 -->
                        <StackPanel Name="FocusSystemPanel" Visibility="Collapsed">
                          <ComboBox Name="FocusSystemPresetComboBox" Style="{StaticResource FlatComboBoxStyle}" Height="30" SelectedValuePath="Key" DisplayMemberPath="DisplayName" SelectionChanged="FocusSystemPresetComboBox_SelectionChanged" />
                        </StackPanel>

                        <!-- 8. 屏幕截屏文字识别 (OCR) 面板 -->
                        <StackPanel Name="FocusOcrPanel" Visibility="Collapsed">
                          <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="*" />
                              <ColumnDefinition Width="Auto" />
                              <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Background="{DynamicResource InputBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10,6" VerticalAlignment="Center">
                              <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="✂️" FontSize="14" FontFamily="Segoe UI Emoji, Segoe UI Symbol, Segoe UI" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBlock Name="FocusOcrStatusText" Text="默认调用 Windows 本地原生 OCR 离线引擎 (0延迟 · 隐私安全)" FontSize="11.5" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                              </StackPanel>
                            </Border>
                            <Button Grid.Column="1" Content="✂️ 立即测试截屏" Style="{StaticResource ModernButtonStyle}" Height="32" Padding="10,0" Margin="6,0,0,0" Click="FocusTestOcr_Click" ToolTip="立即启动全屏框选测试 OCR 识别效果" />
                            <Button Grid.Column="2" Content="⚙️ 接口配置" Style="{StaticResource ModernButtonStyle}" Height="32" Padding="8,0" Margin="6,0,0,0" Click="FocusOpenOcrSettings_Click" ToolTip="配置 OCR 引擎（本地引擎 / AI 视觉大模型 / 自定义 HTTP）" />
                          </Grid>
                        </StackPanel>

                        <!-- 9. 系统与右键工具面板 (ShellTool) -->
                        <StackPanel Name="FocusShellToolPanel" Visibility="Collapsed">
                          <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="*" />
                              <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Background="{DynamicResource InputBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10,6" VerticalAlignment="Center">
                              <Grid>
                                <Grid.ColumnDefinitions>
                                  <ColumnDefinition Width="Auto" />
                                  <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Name="FocusShellToolIconText" Text="⚡" FontSize="18" FontFamily="Segoe UI Emoji, Segoe UI Symbol, Segoe UI" Foreground="{DynamicResource AccentPrimaryBrush}" VerticalAlignment="Center" Margin="0,0,10,0" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                  <TextBlock Name="FocusShellToolTitleText" Text="未挑选功能 (点击右侧挑选)" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                  <TextBlock Name="FocusShellToolDescText" Text="从系统原生增强与右键扩展中选择常用高频功能" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" />
                                </StackPanel>
                              </Grid>
                            </Border>
                            <Button Name="FocusPickShellToolBtn" Grid.Column="1" Content="⚡ 挑选功能..." Style="{StaticResource ModernButtonStyle}" Height="34" Padding="12,0" Margin="6,0,0,0" ToolTip="打开系统与右键工具库，支持搜索与分类" Click="FocusPickShellToolBtn_Click" />
                          </Grid>
                        </StackPanel>

                        <!-- 关联外部程序图标 (解耦执行与外观 Issue #11) -->
                        <Border Name="FocusInheritIconBorder" Background="{DynamicResource SubtleCardBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,10,0,0" Visibility="Collapsed">
                          <StackPanel>
                            <Grid Margin="0,0,0,6">
                              <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                              </Grid.ColumnDefinitions>
                              <WrapPanel VerticalAlignment="Center">
                                <Image Name="FocusInheritIconPreviewImage" Width="16" Height="16" Stretch="Uniform" Margin="0,0,6,0" Visibility="Collapsed" />
                                <TextBlock Text="🏷️ 关联外部程序图标 (解耦执行与外观):" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,8,0" />
                                <TextBlock Name="FocusInheritIconStatusLabel" Text="未关联 (显示默认动作图标)" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                              </WrapPanel>
                              <Button Name="FocusClearInheritedIconBtn" Grid.Column="1" Content="✕ 清除关联" Style="{StaticResource ModernButtonStyle}" Height="24" Padding="6,0" FontSize="10.5" Click="FocusClearInheritedIcon_Click" ToolTip="清除关联的外部程序图标，恢复默认矢量图标" Visibility="Collapsed" />
                            </Grid>
                            <Grid>
                              <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                              </Grid.ColumnDefinitions>
                              <TextBox Name="FocusInheritIconPathTextBox" Height="28" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" IsReadOnly="True" ToolTip="关联提取图标的外部程序或快捷方式路径" TextChanged="FocusInheritIconPathTextBox_TextChanged" />
                              <Button Grid.Column="1" Content="📦 软件库..." Style="{StaticResource ModernButtonStyle}" Height="28" Padding="8,0" Margin="6,0,0,0" Click="FocusPickInheritProgram_Click" ToolTip="从已安装软件与微软商店应用中选取官方高清图标" />
                              <Button Grid.Column="2" Content="🎯 捕捉窗口..." Style="{StaticResource ModernButtonStyle}" Height="28" Padding="8,0" Margin="6,0,0,0" Click="FocusCaptureInheritWindow_Click" ToolTip="直接捕捉桌面上运行中的软件并继承其图标" />
                              <Button Grid.Column="3" Content="📂 浏览..." Style="{StaticResource ModernButtonStyle}" Height="28" Padding="8,0" Margin="6,0,0,0" Click="FocusBrowseInheritIcon_Click" ToolTip="手动浏览提取 .exe / .ico / .lnk 图标" />
                            </Grid>
                          </StackPanel>
                        </Border>
                      </StackPanel>
                    </Border>

                    <!-- 模块 3：二级级联子动作管理 (仅一级扇区呈现) -->
                    <Border Name="FocusSubActionsBorder" Background="{DynamicResource SubtleCardBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12">
                      <StackPanel>
                        <Grid Margin="0,0,0,8">
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                          </Grid.ColumnDefinitions>
                          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="二级级联子动作 (Sub-Actions):" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,6,0" />
                            <TextBlock Name="FocusSubActionsCountLabel" Text="(0 项)" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                          </StackPanel>
                          <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Name="FocusAddSubActionBtn" Content="➕ 添加二级动作" Style="{StaticResource ModernButtonStyle}" Height="26" Padding="8,0" Margin="0,0,4,0" FontSize="11" Click="FocusAddSubActionBtn_Click" />
                            <Button Name="FocusClearSubActionsBtn" Content="🗑️ 清空" Style="{StaticResource ModernButtonStyle}" Height="26" Padding="6,0" FontSize="11" Click="FocusClearSubActionsBtn_Click" />
                            <Button Name="FocusUndoSubActionsBtn" Content="↩️ 撤销" Style="{StaticResource ModernButtonStyle}" Height="26" Padding="6,0" Margin="4,0,0,0" FontSize="11" ToolTip="撤销上一次的修改或清空，恢复二级动作列表" IsEnabled="False" Click="FocusUndoSubActionsBtn_Click" />
                          </StackPanel>
                        </Grid>

                        <!-- 二级子动作芯片列表 -->
                        <WrapPanel Name="FocusSubActionsChipsPanel" Margin="0,2,0,0">
                          <!-- 动态注入二级子动作芯片 (可点击选中进行精调，或点击小叉删除) -->
                        </WrapPanel>
                      </StackPanel>
                    </Border>
                  </StackPanel>

                  <!-- 批量修改模式卡片 (Batch Mode) -->
                  <StackPanel Name="FocusBatchModePanel" Visibility="Collapsed">
                    <!-- 批量模式头部 -->
                    <Grid Margin="0,0,0,12">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <Border Width="36" Height="36" CornerRadius="8" Background="{DynamicResource AccentPrimaryBrush}" Margin="0,0,10,0" VerticalAlignment="Center">
                        <TextBlock Name="FocusBatchBadgeText" Text="多选" FontSize="12" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                      </Border>
                      <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                          <TextBlock Name="FocusBatchTitleText" Text="批量修改模式 (Batch Mode)" FontSize="13.5" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,8,0" />
                          <Border CornerRadius="4" Background="#183B82F6" BorderBrush="#803B82F6" BorderThickness="1" Padding="6,2" VerticalAlignment="Center">
                            <TextBlock Name="FocusBatchTagText" Text="已多选 0 个扇区" FontSize="10.5" FontWeight="SemiBold" Foreground="#3B82F6" />
                          </Border>
                        </StackPanel>
                        <TextBlock Name="FocusBatchSubtitleText" Text="在右侧画布中按住 Ctrl 点击可增减多选扇区；在此统一调整排版属性" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" />
                      </StackPanel>
                      <Button Name="FocusBatchExitBtn" Grid.Column="2" Content="✕ 退出多选" Style="{StaticResource ModernButtonStyle}" Height="28" Padding="10,0" VerticalAlignment="Center" Click="FocusBatchExitBtn_Click" />
                    </Grid>

                    <!-- 批量操作控制区 -->
                    <Border Background="{DynamicResource SubtleCardBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,10">
                      <StackPanel>
                        <!-- 1. 批量排版模式 -->
                        <TextBlock Text="批量切换排版模式 (Layout Mode):" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,6" />
                        <Grid Margin="0,0,0,10">
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                          </Grid.ColumnDefinitions>
                          <Button Name="BatchLayoutBothBtn" Content="🖼️+🔤 图文" Style="{StaticResource ModernButtonStyle}" Height="28" Margin="0,0,4,0" FontSize="10.5" ToolTip="将所有选中扇区批量设为图文并茂居中" Click="BatchLayoutBothBtn_Click" />
                          <Button Name="BatchLayoutIconOnlyBtn" Grid.Column="1" Content="🖼️ 仅图标" Style="{StaticResource ModernButtonStyle}" Height="28" Margin="0,0,4,0" FontSize="10.5" ToolTip="将所有选中扇区批量设为仅显示图标" Click="BatchLayoutIconOnlyBtn_Click" />
                          <Button Name="BatchLayoutTextOnlyBtn" Grid.Column="2" Content="🔤 仅文字" Style="{StaticResource ModernButtonStyle}" Height="28" Margin="0,0,4,0" FontSize="10.5" ToolTip="将所有选中扇区批量设为仅显示文字" Click="BatchLayoutTextOnlyBtn_Click" />
                          <Button Name="BatchLayoutInheritBtn" Grid.Column="3" Content="🌐 继承全局" Style="{StaticResource ModernButtonStyle}" Height="28" FontSize="10.5" ToolTip="将所有选中扇区排版模式批量恢复继承全局" Click="BatchLayoutInheritBtn_Click" />
                        </Grid>

                        <!-- 2. 批量字号与图标大小 -->
                        <Grid Margin="0,0,0,8">
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                          </Grid.ColumnDefinitions>
                          <!-- 批量文字字号 -->
                          <StackPanel Grid.Column="0">
                            <Grid>
                              <TextBlock Text="文字字号大小:" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                              <TextBlock Name="BatchFontSizeLabel" Text="11.0 px" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentPrimaryBrush}" HorizontalAlignment="Right" />
                            </Grid>
                            <Slider Name="BatchFontSizeSlider" Minimum="8" Maximum="20" Value="11.0" SmallChange="0.5" LargeChange="1.0" TickFrequency="0.5" IsSnapToTickEnabled="True" VerticalAlignment="Center" Margin="0,4,0,0" ValueChanged="BatchFontSizeSlider_ValueChanged" />
                          </StackPanel>
                          <!-- 批量图标大小 -->
                          <StackPanel Grid.Column="2">
                            <Grid>
                              <TextBlock Text="图标尺寸大小:" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                              <TextBlock Name="BatchIconSizeLabel" Text="20 px" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentPrimaryBrush}" HorizontalAlignment="Right" />
                            </Grid>
                            <Slider Name="BatchIconSizeSlider" Minimum="12" Maximum="36" Value="20" SmallChange="1" LargeChange="2" TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center" Margin="0,4,0,0" ValueChanged="BatchIconSizeSlider_ValueChanged" />
                          </StackPanel>
                        </Grid>

                        <!-- 3. 批量文字颜色 -->
                        <TextBlock Text="批量文字颜色 (Sector Text Color):" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,4" />
                        <Grid Margin="0,0,0,8">
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="28" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="32" />
                            <ColumnDefinition Width="32" />
                          </Grid.ColumnDefinitions>
                          <Border Name="BatchTextColorPreview" Width="20" Height="20" CornerRadius="4" BorderBrush="{DynamicResource InputBorderBrush}" BorderThickness="1" Margin="0,0,6,0" VerticalAlignment="Center" />
                          <TextBox Name="BatchTextColorTextBox" Grid.Column="1" Height="28" VerticalContentAlignment="Center" Margin="0,0,6,0" TextChanged="BatchTextColorTextBox_TextChanged" />
                          <Button Grid.Column="2" Content="🎨" Width="28" Height="28" Padding="0" Margin="0,0,4,0" ToolTip="打开调色板选取颜色" Tag="BatchCustomText" Style="{StaticResource ModernButtonStyle}" Click="PickCustomColor_Click" />
                          <Button Grid.Column="3" Content="🔍" Width="28" Height="28" Padding="0" ToolTip="从屏幕任意位置吸取颜色" Tag="BatchCustomText" Style="{StaticResource ModernButtonStyle}" Click="PickEyedropper_Click" />
                        </Grid>

                        <!-- 4. 批量边距微调 (X/Y 偏移) -->
                        <Grid Margin="0,2,0,8">
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                          </Grid.ColumnDefinitions>
                          <StackPanel Grid.Column="0">
                            <Grid>
                              <TextBlock Text="水平边距 (X 偏移):" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                              <TextBlock Name="BatchTextOffsetXLabel" Text="0 px" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AccentPrimaryBrush}" HorizontalAlignment="Right" />
                            </Grid>
                            <Slider Name="BatchTextOffsetXSlider" Minimum="-40" Maximum="40" Value="0" SmallChange="1" LargeChange="5" TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center" Margin="0,4,0,0" ValueChanged="BatchTextOffsetSlider_ValueChanged" />
                          </StackPanel>
                          <StackPanel Grid.Column="2">
                            <Grid>
                              <TextBlock Text="垂直边距 (Y 偏移):" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                              <TextBlock Name="BatchTextOffsetYLabel" Text="0 px" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AccentPrimaryBrush}" HorizontalAlignment="Right" />
                            </Grid>
                            <Slider Name="BatchTextOffsetYSlider" Minimum="-40" Maximum="40" Value="0" SmallChange="1" LargeChange="5" TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center" Margin="0,4,0,0" ValueChanged="BatchTextOffsetSlider_ValueChanged" />
                          </StackPanel>
                        </Grid>

                        <!-- 5. 一键复位 -->
                        <Border BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,1,0,0" Padding="0,8,0,0" Margin="0,4,0,0">
                          <Grid>
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="*" />
                              <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="💡 清除所有选中槽位的独立定制，恢复跟随全局统一外观" FontSize="10.5" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" TextWrapping="Wrap" />
                            <Button Name="BatchResetCustomBtn" Grid.Column="1" Content="🔄 清除自定义，恢复跟随全局统一" Style="{StaticResource ModernButtonStyle}" Height="28" Padding="10,0" Margin="8,0,0,0" Click="BatchResetCustomBtn_Click" />
                          </Grid>
                        </Border>
                      </StackPanel>
                    </Border>
                  </StackPanel>
                </StackPanel>
              </Border>
              </StackPanel>
            </ScrollViewer>

            <!-- 分割线与拖拽调整手柄 (GridSplitter) -->
            <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Center" VerticalAlignment="Stretch"
                          Background="Transparent" ShowsPreview="False" Cursor="SizeWE"
                          DragCompleted="Tab2GridSplitter_DragCompleted" MouseDoubleClick="Tab2GridSplitter_MouseDoubleClick"
                          ToolTip="拖拽调整画布与配置区比例，双击恢复默认比例">
              <GridSplitter.Template>
                <ControlTemplate TargetType="{x:Type GridSplitter}">
                  <Border Background="Transparent" Width="8" HorizontalAlignment="Center">
                    <Border Width="1" Background="{DynamicResource CardBorderBrush}" HorizontalAlignment="Center" VerticalAlignment="Stretch" Opacity="0.6" />
                  </Border>
                </ControlTemplate>
              </GridSplitter.Template>
            </GridSplitter>

            <!-- 右栏：实时交互画布 (Interactive Wheel Canvas) -->
            <Border Grid.Column="2" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="14">
              <Grid>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="*" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                
                <!-- 画布顶部工具条与分段切换 -->
                <StackPanel Grid.Row="0" Margin="0,0,0,8">
                  <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="实时交互画布 (Live Wheel)" FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                    <Button Name="MappingsLinkSubActionsBtn" Grid.Column="1" Style="{StaticResource ModernButtonStyle}" Height="24" Padding="8,0" Margin="0,0,8,0" ToolTip="开启时：拖拽一级扇区将连同绑定的二级子轮盘一起对调换位&#x0a;关闭时：仅对调一级扇区主动作，保留各方位现存的二级子菜单" Click="MappingsLinkSubActionsBtn_Click">
                      <StackPanel Orientation="Horizontal">
                        <TextBlock Name="MappingsLinkSubActionsIcon" Text="🔗" FontSize="11" Margin="0,0,4,0" VerticalAlignment="Center" />
                        <TextBlock Name="MappingsLinkSubActionsText" Text="一二级链接: 开启" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                      </StackPanel>
                    </Button>
                    <Border Grid.Column="2" Background="#ECFDF5" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                      <TextBlock Text="60FPS 同步" FontSize="10" FontWeight="Bold" Foreground="#059669" />
                    </Border>
                  </Grid>
                  <TextBlock Text="💡 点击内圈选一级扇区，点击外环选二级动作，点击中心选核圆；按住拖动可对调功能位置！" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,6" />

                  <!-- 一二级轮盘预览分段切换 -->
                  <Border Background="{DynamicResource SubtleCardBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="3">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <RadioButton Name="MappingsTier1SegmentRadio" Content="🔘 一级主轮盘" GroupName="MappingsTierSegmentGroup" IsChecked="True" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Height="26" Cursor="Hand" FontWeight="SemiBold" Checked="MappingsTierSegmentRadio_Checked" />
                      <RadioButton Name="MappingsTier2SegmentRadio" Grid.Column="1" Content="🌟 二级级联" GroupName="MappingsTierSegmentGroup" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Height="26" Cursor="Hand" FontWeight="SemiBold" Checked="MappingsTierSegmentRadio_Checked" />
                    </Grid>
                  </Border>
                </StackPanel>

                <!-- 画布视口容器 (支持平移、缩放与扇区/中心圆拖拽交互) -->
                <Border Grid.Row="1" Background="{DynamicResource PreviewCanvasBackgroundBrush}" BorderBrush="{DynamicResource PreviewCanvasBorderBrush}" BorderThickness="1" CornerRadius="10" ClipToBounds="True" Margin="0,2,0,8">
                  <Grid>
                    <Grid Name="MappingsPreviewViewportContainer" ClipToBounds="True" Background="Transparent" MouseWheel="MappingsPreviewViewport_MouseWheel" PreviewMouseDown="MappingsPreviewViewport_MouseDown" PreviewMouseMove="MappingsPreviewViewport_MouseMove" PreviewMouseUp="MappingsPreviewViewport_MouseUp">
                      <Path Stroke="{DynamicResource PreviewGridLineBrush}" StrokeThickness="0.5" Data="M0,150 L300,150 M150,0 L150,300" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" />
                      <Canvas Name="MappingsWheelPreviewCanvas" Width="300" Height="300" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Canvas.RenderTransform>
                          <TransformGroup>
                            <ScaleTransform x:Name="MappingsPreviewScaleTransform" ScaleX="1.0" ScaleY="1.0" CenterX="150" CenterY="150" />
                            <TranslateTransform x:Name="MappingsPreviewTranslateTransform" X="0" Y="0" />
                          </TransformGroup>
                        </Canvas.RenderTransform>
                      </Canvas>
                    </Grid>
                    
                    <!-- 悬浮工具栏 (放在 ViewportContainer 之上同级，避免被 Viewport 的 Preview 事件劫持) -->
                    <Border Name="MappingsZoomToolbarBorder" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,6,6,0" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="3,2">
                      <Border.Effect>
                        <DropShadowEffect BlurRadius="8" ShadowDepth="1" Color="#000000" Opacity="0.12" />
                      </Border.Effect>
                      <StackPanel Orientation="Horizontal">
                        <Button Name="MappingsShowTextToggleBtn" Content="🔤 图文" ToolTip="开启/关闭动作名称复合展示（开启后在扇区中直观渲染动作名称与图标，让拖拽对调一目了然）" Style="{StaticResource CanvasToolBtnStyle}" Width="52" Height="24" Padding="4,0" FontSize="10.5" FontWeight="SemiBold" Margin="0,0,3,0" Click="MappingsShowTextToggleBtn_Click" />
                        <Border Width="1" Height="12" Background="{DynamicResource CardBorderBrush}" Margin="0,0,3,0" VerticalAlignment="Center" />
                        <Button Name="MappingsZoomOutBtn" Content="➖" ToolTip="缩小视图" Style="{StaticResource CanvasToolBtnStyle}" FontSize="10" Click="MappingsZoomOutBtn_Click" />
                        <TextBlock Name="MappingsZoomLabel" Text="100%" Width="36" TextAlignment="Center" VerticalAlignment="Center" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Cursor="Hand" ToolTip="点击复位为 100%" MouseLeftButtonDown="MappingsZoomLabel_MouseLeftButtonDown" />
                        <Button Name="MappingsZoomInBtn" Content="➕" ToolTip="放大视图" Style="{StaticResource CanvasToolBtnStyle}" FontSize="10" Click="MappingsZoomInBtn_Click" />
                        <Border Width="1" Height="12" Background="{DynamicResource CardBorderBrush}" Margin="2,0" VerticalAlignment="Center" />
                        <Button Name="MappingsResetViewBtn" Content="🎯" ToolTip="重置视图" Style="{StaticResource CanvasToolBtnStyle}" FontSize="10" Click="MappingsResetViewBtn_Click" />
                      </StackPanel>
                    </Border>

                    <!-- 左下角当前编辑状态标签 -->
                    <Border HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="6,0,0,6" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="6,2" IsHitTestVisible="False">
                      <TextBlock Name="MappingsCurrentEditIndicator" Text="🎯 正在编辑: 扇区 1 [向上]" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource AccentPrimaryBrush}" />
                    </Border>
                  </Grid>
                </Border>

                <!-- 底部保存/提示 -->
                <TextBlock Grid.Row="2" Text="💡 修改在内存中即时生效，点击主窗口右下角【保存并生效】持久化至硬盘。" FontSize="10.5" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" />
              </Grid>
            </Border>
          </Grid>

          <!-- 模式 2：紧凑全览列表模式 (MappingsListModeGrid) -->
          <Grid Name="MappingsListModeGrid" Grid.Row="1" Visibility="Collapsed">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
              <StackPanel Margin="0,0,10,32">
                <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="18" Margin="0,0,0,14">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                      <TextBlock Text="当前配置方案 (Profile)" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                      <TextBlock Text="选择或新建针对特定程序（如 Chrome、VS Code）或特定工作流的轮盘配置方案（支持双击重命名）。" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,10" />
                      <ListBox Name="ProfilesListBox" Height="100" DisplayMemberPath="DisplayTitle" SelectionChanged="ProfilesListBox_SelectionChanged" MouseDoubleClick="ProfilesListBox_MouseDoubleClick" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="15,0,0,0">
                      <Button Name="AddProfileButton" Content="➕ 新增专属程序配置" Style="{StaticResource PrimaryButtonStyle}" Height="30" Margin="0,0,0,5" ToolTip="从已安装软件或开始菜单中选择程序创建专属配置" Click="AddProfileButton_Click" />
                      <Button Name="AddCustomProfileButton" Content="➕ 新建自定义配置" Style="{StaticResource ModernButtonStyle}" Height="30" Margin="0,0,0,5" ToolTip="自定义命名创建新的轮盘配置方案" Click="AddCustomProfileButton_Click" />
                      <Button Name="RenameProfileButton" Content="✏️ 重命名当前配置" Style="{StaticResource ModernButtonStyle}" Height="30" Margin="0,0,0,5" ToolTip="重命名选中的配置方案" Click="RenameProfileButton_Click" />
                      <Button Name="DeleteProfileButton" Content="🗑️ 删除当前配置" Style="{StaticResource ModernButtonStyle}" Height="30" ToolTip="删除选中的配置方案" Click="DeleteProfileButton_Click" />
                    </StackPanel>
                  </Grid>
                </Border>
                <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="18" Margin="0,0,0,14">
                  <StackPanel>
                    <TextBlock Text="扇区方位数量 (Sector Count)" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                    <TextBlock Text="切换手势轮盘的切分数量。4 键最快最不易误触，8 键为标准全能方位，12 键适合功能密集场景。" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,10" />
                    <StackPanel Orientation="Horizontal">
                      <RadioButton Name="SectorCount4Radio" GroupName="SectorCountGroup" Content="4 键十字方位" Margin="0,0,24,0" Checked="SectorCountRadio_Checked" />
                      <RadioButton Name="SectorCount8Radio" GroupName="SectorCountGroup" Content="8 键全向方位 (推荐)" Margin="0,0,24,0" IsChecked="True" Checked="SectorCountRadio_Checked" />
                      <RadioButton Name="SectorCount12Radio" GroupName="SectorCountGroup" Content="12 键钟表方位" Checked="SectorCountRadio_Checked" />
                    </StackPanel>
                  </StackPanel>
                </Border>
                <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="18">
                  <StackPanel>
                    <TextBlock Text="扇区动作映射列表" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                    <TextBlock Text="为每个方位指定触发动作与图标。支持热键组合（如 Ctrl+C）、启动本地程序与系统级操作。" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,2" />
                    <TextBlock Text="点击右侧功能卡的 ▲ / ▼ 箭头，将功能移动到相邻的轮盘位置槽。" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,14" />
                    <ItemsControl Name="SlotsItemsControl">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <Grid Tag="SlotActionRow" Margin="0,0,0,8" Visibility="{Binding IsVisible, Converter={StaticResource BoolToVis}}">
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="92" />
                              <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Margin="0,0,10,0" Padding="5" VerticalAlignment="Stretch" CornerRadius="8" Background="{DynamicResource SubtleCardBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" ToolTip="{Binding DirectionLabel}" AutomationProperties.Name="{Binding DirectionLabel}">
                              <local:WheelPositionIndicator
                                PositionIndex="{Binding PositionIndex}"
                                SectorCount="{Binding SectorCount}"
                                Width="64"
                                Height="64"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                IsHitTestVisible="False"
                                AccentBrush="{DynamicResource AccentPrimaryBrush}"
                                AccentTextBrush="{DynamicResource AccentTextBrush}"
                                SectorBrush="{DynamicResource InputBackgroundBrush}"
                                BorderBrush="{DynamicResource CardBorderBrush}"
                                MutedBrush="{DynamicResource TextMutedBrush}"
                                CenterBrush="{DynamicResource CardBackgroundBrush}" />
                            </Border>

                            <Border Grid.Column="1" Background="{DynamicResource SubtleCardBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10,8">
                              <Grid>
                                <Grid.ColumnDefinitions>
                                  <ColumnDefinition Width="86" />
                                  <ColumnDefinition Width="132" MinWidth="132" />
                                  <ColumnDefinition Width="136" MinWidth="136" />
                                  <ColumnDefinition Width="*" MinWidth="200" />
                                  <ColumnDefinition Width="Auto" />
                                  <ColumnDefinition Width="Auto" />
                                  <ColumnDefinition Width="Auto" />
                                  <ColumnDefinition Width="58" />
                                </Grid.ColumnDefinitions>

                                <Button Grid.Column="0" Style="{StaticResource ModernButtonStyle}" Height="30" Padding="6,0" Margin="0,0,8,0" Click="PickIcon_Click" ToolTip="点击选取矢量图标">
                                  <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <Image Width="14" Height="14" Stretch="Uniform" Margin="0,0,4,0" Source="{Binding InheritedAppIcon}" Visibility="{Binding HasInheritedAppIcon, Converter={StaticResource BoolToVis}}" />
                                    <Path Width="14" Height="14" Stretch="Uniform" Fill="{DynamicResource AccentPrimaryBrush}" Margin="0,0,4,0" Data="{Binding VectorIconData}" Visibility="{Binding ShowVectorIcon, Converter={StaticResource BoolToVis}}" />
                                    <TextBlock Text="{Binding IconDisplayText}" FontSize="11" Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" MaxWidth="52" />
                                  </StackPanel>
                                </Button>

                                <TextBox Grid.Column="1" Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0" Height="30" FontSize="12" VerticalContentAlignment="Center" />

                                <ComboBox Grid.Column="2" ItemsSource="{Binding ActionTypes}" SelectedValue="{Binding Type, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" SelectedValuePath="Tag" DisplayMemberPath="DisplayText" Style="{StaticResource FlatComboBoxStyle}" Height="30" Margin="0,0,8,0" FontSize="11.5" Padding="8,0" HorizontalContentAlignment="Left" ToolTip="{Binding Type}" />

                                <Grid Grid.Column="3" Margin="0,0,8,0">
                                  <Grid Visibility="{Binding IsHotkeyType, Converter={StaticResource BoolToVis}}">
                                    <Grid.ColumnDefinitions>
                                      <ColumnDefinition Width="*" />
                                      <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <local:HotkeyRecorderBox Height="30" FontSize="12" HotkeyText="{Binding Parameter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <Button Grid.Column="1" Content="⚙️ 拼装" Margin="4,0,0,0" Height="30" Padding="6,0" Cursor="Hand" ToolTip="打开快捷热键拼装组合器（支持 Alt+Tab、Win+Tab、Shift+Alt、多位连续数值等）" Click="HotkeyBuilderButton_Click" Style="{StaticResource ModernButtonStyle}" />
                                  </Grid>
                                  <Grid Visibility="{Binding IsLaunchType, Converter={StaticResource BoolToVis}}">
                                    <Grid.ColumnDefinitions>
                                      <ColumnDefinition Width="*" />
                                      <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox IsReadOnly="True" Background="{DynamicResource InputBackgroundBrush}" Foreground="{DynamicResource TextSecondaryBrush}" Height="30" Margin="0,0,4,0" FontSize="11" VerticalContentAlignment="Center" ToolTip="选择的应用程序路径" Text="{Binding Parameter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <Button Grid.Column="1" Width="34" Style="{StaticResource ModernButtonStyle}" Height="30" ToolTip="选择应用程序或快捷方式..." Click="Browse_Click">
                                      <TextBlock Text="📁" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Button>
                                  </Grid>
                                  <Grid Visibility="{Binding IsWebUrlType, Converter={StaticResource BoolToVis}}">
                                    <Grid.ColumnDefinitions>
                                      <ColumnDefinition Width="*" />
                                      <ColumnDefinition Width="90" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Background="{DynamicResource InputBackgroundBrush}" Foreground="{DynamicResource TextPrimaryBrush}" Height="30" Margin="0,0,4,0" FontSize="11" VerticalContentAlignment="Center" ToolTip="目标网址，如 https://github.com" Text="{Binding Parameter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <ComboBox Grid.Column="1" Style="{StaticResource FlatComboBoxStyle}" Height="30" SelectedValue="{Binding BrowserChoice, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" SelectedValuePath="Tag">
                                      <ComboBoxItem Tag="Default" Content="默认" />
                                      <ComboBoxItem Tag="Chrome" Content="Chrome" />
                                      <ComboBoxItem Tag="Edge" Content="Edge" />
                                      <ComboBoxItem Tag="Firefox" Content="Firefox" />
                                      <ComboBoxItem Tag="Custom" Content="自定义" />
                                    </ComboBox>
                                  </Grid>
                                  <Grid Visibility="{Binding IsFolderType, Converter={StaticResource BoolToVis}}">
                                    <Grid.ColumnDefinitions>
                                      <ColumnDefinition Width="*" />
                                      <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Background="{DynamicResource InputBackgroundBrush}" Foreground="{DynamicResource TextPrimaryBrush}" Height="30" Margin="0,0,4,0" FontSize="11" VerticalContentAlignment="Center" ToolTip="选择的本地文件夹路径" Text="{Binding Parameter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <Button Grid.Column="1" Width="34" Style="{StaticResource ModernButtonStyle}" Height="30" ToolTip="选择本地文件夹..." Click="BrowseFolder_Click">
                                      <TextBlock Text="📂" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Button>
                                  </Grid>
                                  <ComboBox SelectedValuePath="Key" DisplayMemberPath="Value" Style="{StaticResource FlatComboBoxStyle}" Height="30" FontSize="11.5" SelectedValue="{Binding SelectedSystemPreset, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ItemsSource="{Binding Source={x:Static local:SlotViewModel.SystemPresets}}" Visibility="{Binding IsSystemType, Converter={StaticResource BoolToVis}}" />
                                  <Grid Visibility="{Binding IsCommandType, Converter={StaticResource BoolToVis}}">
                                    <Grid.ColumnDefinitions>
                                      <ColumnDefinition Width="*" />
                                      <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" Text="{Binding Parameter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Height="30" Margin="0,0,4,0" FontSize="11" VerticalContentAlignment="Center" ToolTip="要运行的命令，如 ping -n 3 127.0.0.1" />
                                    <ComboBox Grid.Column="1" Width="118" ItemsSource="{Binding Terminals}" SelectedValuePath="Tag" DisplayMemberPath="DisplayText" SelectedValue="{Binding CommandTerminal, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FlatComboBoxStyle}" Height="30" FontSize="11" />
                                  </Grid>
                                  <Grid Visibility="{Binding IsSwitchWindowType, Converter={StaticResource BoolToVis}}">
                                    <TextBox Text="{Binding NthWindowIndex, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Height="30" FontSize="11" VerticalContentAlignment="Center" ToolTip="任务栏第 N 个应用（顺序同任务栏/Win+N 槽位，稳定）；图标与切换目标一致；固定未运行的槽位无法启动，托盘驻留不计入" />
                                  </Grid>
                                  <ComboBox SelectedValuePath="Tag" DisplayMemberPath="DisplayText" ItemsSource="{Binding TileLayoutOptions}" SelectedValue="{Binding TileLayout, Mode=TwoWay}" SelectionChanged="TileLayoutComboBox_SelectionChanged" Style="{StaticResource FlatComboBoxStyle}" Height="30" FontSize="11" Visibility="{Binding IsTileType, Converter={StaticResource BoolToVis}}" ToolTip="平铺布局预设" />
                                </Grid>

                                <TextBox Grid.Column="4" Width="68" Margin="0,0,8,0" Height="30" FontSize="11" ToolTip="启动参数 (如命令行参数或URL)" VerticalContentAlignment="Center" Text="{Binding Arguments, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsLaunchType}" Visibility="{Binding IsLaunchType, Converter={StaticResource BoolToVis}}" />
                                <Button Grid.Column="5" Style="{StaticResource ModernButtonStyle}" Height="30" Padding="8,0" Margin="0,0,6,0" ToolTip="配置该扇区的二级级联子动作菜单" Content="{Binding SubActionButtonText}" Click="ManageSubActions_Click" />

                                <StackPanel Grid.Column="6" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,6,0">
                                  <Button Width="28" Height="30" Padding="0" Margin="0,0,4,0" Style="{StaticResource ModernButtonStyle}" Content="▲" IsEnabled="{Binding CanMoveUp}" ToolTip="{Binding MoveUpToolTip}" Click="MoveSlotUp_Click" AutomationProperties.Name="{Binding MoveUpToolTip}" />
                                  <Button Width="28" Height="30" Padding="0" Style="{StaticResource ModernButtonStyle}" Content="▼" IsEnabled="{Binding CanMoveDown}" ToolTip="{Binding MoveDownToolTip}" Click="MoveSlotDown_Click" AutomationProperties.Name="{Binding MoveDownToolTip}" />
                                </StackPanel>

                                <Button Grid.Column="7" Style="{StaticResource ModernButtonStyle}" Height="30" Padding="10,0" Content="{Binding TestButtonText}" Click="Test_Click" />
                              </Grid>
                            </Border>
                          </Grid>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </Border>

                <!-- 平铺窗口全局设置 (可折叠收纳) -->
                <Border Name="Tab2_TileSettingsCardBorder" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="20,16" Margin="0,0,0,14">
                  <UIElement.Effect>
                    <DropShadowEffect BlurRadius="12" ShadowDepth="1" Color="#000000" Opacity="0.03" />
                  </UIElement.Effect>
                  <StackPanel>
                    <!-- 头部栏 (点击展开/折叠) -->
                    <Grid Cursor="Hand" MouseLeftButtonDown="ToggleTileSettingsCard_Click" Background="Transparent">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                          <TextBlock Name="TileGlobalTitleText" Text="🪟 平铺窗口高级设置" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                          <Border Name="TileSettingsStatusBadge" Background="{DynamicResource SubtleCardBrush}" CornerRadius="8" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center">
                            <TextBlock Name="TileSettingsStatusText" Text="已收纳 (点击展开)" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource AccentPrimaryBrush}" />
                          </Border>
                        </StackPanel>
                        <TextBlock Name="TileGlobalDescText" Text="「平铺窗口」动作的全局行为（屏幕边距、窗口间距、包含最小化窗口、排除名单与多布局循环切换）。" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,3,0,0" TextWrapping="Wrap" />
                      </StackPanel>
                      <Border Grid.Column="1" Background="{DynamicResource SubtleCardBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="8,4" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                          <TextBlock Name="TileSettingsToggleLabel" Text="展开配置" FontSize="11" FontWeight="Medium" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                          <TextBlock Name="TileSettingsExpandArrow" Text="▼" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="6,0,0,0" />
                        </StackPanel>
                      </Border>
                    </Grid>

                    <!-- 折叠收纳的详细配置面板 (默认收起折叠) -->
                    <StackPanel Name="TileSettingsContentPanel" Margin="0,14,0,0" Visibility="Collapsed">
                      <CheckBox Name="TileIncludeMinimizedCheckBox" Style="{StaticResource ToggleSwitchStyle}" Margin="0,0,0,10" Checked="TileIncludeMinimizedCheckBox_Changed" Unchecked="TileIncludeMinimizedCheckBox_Changed">
                        <StackPanel Margin="6,0,0,0">
                          <TextBlock Name="TileMinimizeText" Text="包含最小化窗口（还原后参与平铺）" FontWeight="Medium" Foreground="{DynamicResource TextPrimaryBrush}" />
                          <TextBlock Text="默认关闭：最小化窗口不参与，仅排布可见窗口。" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" />
                        </StackPanel>
                      </CheckBox>
                      <TextBlock Name="TileExcludeText" Text="平铺排除名单（进程 exe 名，逗号分隔，如 notepad,spotify）：" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,6" />
                      <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Name="TileExcludeProcessesTextBox" Height="32" FontSize="12" VerticalContentAlignment="Center" Padding="8,0" TextChanged="TileExcludeProcessesTextBox_TextChanged" />
                        <Button Grid.Column="1" Content="🎯 捕捉排除进程..." Style="{StaticResource ModernButtonStyle}" Height="32" Padding="10,0" Margin="6,0,0,0" ToolTip="打开智能窗口捕捉器，选取桌面运行中的程序加入平铺排除名单（自动安全排除 StarPie 自身）" Click="TileCaptureCurrentProcess_Click" />
                      </Grid>
                      <TextBlock Name="TileMarginText" Text="屏幕边距（上 / 下 / 左 / 右，物理像素，0 = 贴边）：" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,6" />
                      <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="6" />
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="6" />
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="6" />
                          <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBox Name="TileMarginTopTextBox" Grid.Column="0" Height="32" FontSize="12" VerticalContentAlignment="Center" Padding="8,0" Tag="Top" TextChanged="TileMarginTextBox_TextChanged" ToolTip="上边距（0~1000 物理像素）" />
                        <TextBox Name="TileMarginBottomTextBox" Grid.Column="2" Height="32" FontSize="12" VerticalContentAlignment="Center" Padding="8,0" Tag="Bottom" TextChanged="TileMarginTextBox_TextChanged" ToolTip="下边距（0~1000 物理像素）" />
                        <TextBox Name="TileMarginLeftTextBox" Grid.Column="4" Height="32" FontSize="12" VerticalContentAlignment="Center" Padding="8,0" Tag="Left" TextChanged="TileMarginTextBox_TextChanged" ToolTip="左边距（0~1000 物理像素）" />
                        <TextBox Name="TileMarginRightTextBox" Grid.Column="6" Height="32" FontSize="12" VerticalContentAlignment="Center" Padding="8,0" Tag="Right" TextChanged="TileMarginTextBox_TextChanged" ToolTip="右边距（0~1000 物理像素）" />
                      </Grid>
                      <TextBlock Name="TileGapText" Text="窗口间距（物理像素，0 = 紧贴）：" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,6" />
                      <TextBox Name="TileGapTextBox" Width="80" HorizontalAlignment="Left" Height="32" FontSize="12" VerticalContentAlignment="Center" Padding="8,0" Margin="0,0,0,10" TextChanged="TileGapTextBox_TextChanged" ToolTip="相邻窗口之间的空隙（0~500 物理像素）" />
                      <Grid Margin="0,4,0,6">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Name="TileCycleRangeText" Text="循环切换布局（勾选参与项，▲▼ 调顺序；不勾任何项=全部参与）：" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Content="✨ 经典常用 (4项)" Style="{StaticResource ModernButtonStyle}" Height="24" Padding="6,0" FontSize="10.5" ToolTip="一键勾选 2L、2T、3L12、4G 四种高频排布" Click="TileCyclePresetClassic_Click" />
                      </Grid>
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="42" />
                        </Grid.ColumnDefinitions>
                        <ListBox Name="TileCycleListBox" Height="168" SelectionMode="Single" BorderThickness="0" Background="Transparent" ScrollViewer.VerticalScrollBarVisibility="Auto">
                          <ListBox.ItemTemplate>
                            <DataTemplate>
                              <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}" Content="{Binding Display}" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                            </DataTemplate>
                          </ListBox.ItemTemplate>
                        </ListBox>
                        <StackPanel Grid.Column="1" Margin="6,0,0,0">
                          <Button Content="▲" Height="28" Width="36" Padding="0" FontSize="11" Style="{StaticResource ModernButtonStyle}" Click="TileCycleUp_Click" ToolTip="上移" />
                          <Button Content="▼" Height="28" Width="36" Padding="0" FontSize="11" Margin="0,4,0,0" Style="{StaticResource ModernButtonStyle}" Click="TileCycleDown_Click" ToolTip="下移" />
                          <Button Content="全" Height="26" Width="36" Padding="0" FontSize="10" Margin="0,6,0,0" Style="{StaticResource ModernButtonStyle}" Click="TileCycleAll_Click" ToolTip="全部参与循环" />
                          <Button Content="空" Height="26" Width="36" Padding="0" FontSize="10" Margin="0,4,0,0" Style="{StaticResource ModernButtonStyle}" Click="TileCycleNone_Click" ToolTip="清空（等效全部参与）" />
                        </StackPanel>
                      </Grid>
                    </StackPanel>
                  </StackPanel>
                </Border>
              </StackPanel>
            </ScrollViewer>
          </Grid>
        </Grid>
        <Grid Name="SystemSettingsGrid" Visibility="Collapsed">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
              <TextBlock Name="AdvancedPageHeader" Text="高级系统与运维备份" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
              <TextBlock Name="AdvancedPageSubheader" Text="管理界面语言、Windows 开机自启、管理员提权与配置文件的导入/导出备份。" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0" />
            </StackPanel>

            <!-- 🤝 贡献者致谢可折叠卡片 (与 GitHub 仓库实时同步) -->
            <Border Name="ContributorsCardBorder" Grid.Column="1" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="12,8" VerticalAlignment="Center" SnapsToDevicePixels="True">
              <Border.Effect>
                <DropShadowEffect BlurRadius="10" ShadowDepth="1" Color="#000000" Opacity="0.04" />
              </Border.Effect>
              <StackPanel>
                <!-- 头部栏 (点击展开/折叠) -->
                <Grid Cursor="Hand" MouseLeftButtonDown="ToggleContributorsCard_Click" Background="Transparent">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="🤝" FontSize="14" VerticalAlignment="Center" Margin="0,0,6,0" />
                  <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Name="ContributorsHeaderTitle" Text="开源贡献者致谢" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                    <Border Name="ContributorsCountBadge" Background="{DynamicResource SubtleCardBrush}" CornerRadius="8" Padding="6,1" Margin="6,0,0,0" VerticalAlignment="Center">
                      <TextBlock Name="ContributorsCountText" Text="Syncing..." FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource AccentPrimaryBrush}" />
                    </Border>
                  </StackPanel>
                  <TextBlock Name="ContributorsExpandArrow" Grid.Column="2" Text="▼" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="10,0,2,0" />
                </Grid>

                <!-- 折叠展开的贡献者列表区 -->
                <StackPanel Name="ContributorsContentPanel" Margin="0,8,0,0" Visibility="Collapsed">
                  <TextBlock Name="ContributorsIntroText" Text="感谢以下贡献者为 StarPie (星盘) 开源项目付出的智慧与贡献：" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,8" TextWrapping="Wrap" />
                  <ScrollViewer MaxHeight="180" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                    <WrapPanel Name="ContributorsWrapPanel" MaxWidth="380">
                      <!-- 动态填充圆形头像与用户名徽标 -->
                    </WrapPanel>
                  </ScrollViewer>
                  <Border BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,1,0,0" Margin="0,8,0,0" Padding="0,5,0,0">
                    <Grid>
                      <TextBlock Name="ContributorsSyncStatusText" Text="🌐 本地收录名单 (检查更新时可联网刷新)" FontSize="9.5" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />
                      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock Name="ContributorsRefreshText" Text="🔄 刷新" FontSize="9.5" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Cursor="Hand" Margin="0,0,10,0" VerticalAlignment="Center" MouseLeftButtonDown="RefreshContributors_Click" ToolTip="向 GitHub API 请求最新贡献者数据" />
                        <TextBlock Name="ContributorsRepoText" Text="★ 访问 GitHub 仓库" FontSize="9.5" FontWeight="SemiBold" Foreground="{DynamicResource AccentPrimaryBrush}" Cursor="Hand" VerticalAlignment="Center" MouseLeftButtonDown="OpenGitHubRepo_Click" />
                      </StackPanel>
                    </Grid>
                  </Border>
                </StackPanel>
              </StackPanel>
            </Border>
          </Grid>
          <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="0,0,10,36">
              <!-- Card 0: 系统在线更新与版本管理 -->
              <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="20" Margin="0,0,0,14">
                <UIElement.Effect>
                  <DropShadowEffect BlurRadius="12" ShadowDepth="1" Color="#000000" Opacity="0.03" />
                </UIElement.Effect>
                <StackPanel>
                  <!-- 顶部状态栏 -->
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="🚀" FontSize="15" FontFamily="Segoe UI Emoji, Segoe UI Symbol, Segoe UI" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock Name="UpdateSectionTitleText" Text="软件更新与版本管理 (Software Updates)" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                        <Border Name="UpdateStatusBadge" Background="{DynamicResource NavTabActiveBgBrush}" CornerRadius="4" Padding="7,2" Margin="10,0,0,0" VerticalAlignment="Center">
                          <TextBlock Name="UpdateStatusBadgeText" Text="已是最新版本" FontWeight="Bold" Foreground="{DynamicResource AccentPrimaryBrush}" FontSize="11" />
                        </Border>
                      </StackPanel>
                      <TextBlock Name="UpdateStatusDescText" Text="当前运行版本: StarPie v1.7.3-beta.6 (64位)。" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                      <Button Name="CheckUpdateNowBtn" Content="🔄 立即检查更新" Style="{StaticResource ModernButtonStyle}" Height="34" Padding="14,0" Margin="0,0,8,0" VerticalAlignment="Center" Click="CheckUpdateNowBtn_Click" />
                      <Button Name="ViewReleasesWebBtn" Content="🌐 网页发布页" Style="{StaticResource ModernButtonStyle}" Height="34" Padding="12,0" VerticalAlignment="Center" Click="OpenWebReleaseBtn_Click" ToolTip="直接在默认浏览器中打开 GitHub Releases 发布页" />
                    </StackPanel>
                  </Grid>

                  <!-- 状态区 A: 发现新版本 -->
                  <Border Name="UpdateNewVersionPanel" Visibility="Collapsed" Background="{DynamicResource SubtleCardBrush}" BorderBrush="{DynamicResource AccentPrimaryBrush}" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,14,0,0">
                    <StackPanel>
                      <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                          <StackPanel Orientation="Horizontal">
                            <TextBlock Name="UpdateNewVersionTagText" Text="🎉 发现新版本 v1.7.3-beta.6" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource AccentPrimaryBrush}" VerticalAlignment="Center" />
                            <Border Background="#25F59E0B" CornerRadius="4" Padding="6,2" Margin="8,0,0,0" VerticalAlignment="Center">
                              <TextBlock Name="UpdateReleaseChannelTag" Text="正式稳定版" FontSize="10" FontWeight="SemiBold" Foreground="#F59E0B" />
                            </Border>
                          </StackPanel>
                          <TextBlock Name="UpdateReleaseDateText" Text="发布于 GitHub Releases" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" />
                        </StackPanel>
                        <WrapPanel Grid.Column="1" VerticalAlignment="Center">
                          <Button Name="StartDownloadUpdateBtn" Content="⬇️ 立即下载更新" Style="{StaticResource ModernButtonStyle}" Height="32" Padding="12,0" Margin="0,0,8,0" Click="StartDownloadUpdateBtn_Click" />
                          <Button Name="OpenWebReleaseBtn" Content="🌐 前往网页" Style="{StaticResource ModernButtonStyle}" Height="32" Padding="10,0" Click="OpenWebReleaseBtn_Click" />
                        </WrapPanel>
                      </Grid>

                      <!-- 发行包选择 -->
                      <Border BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,1,0,0" Padding="0,10,0,0" Margin="0,4,0,8">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                          <TextBlock Text="📦 下载版本:" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,12,0" VerticalAlignment="Center" />
                          <RadioButton Name="UpdatePkgStandaloneRadio" Content="独立免安装单文件版 (~68 MB, 推荐)" IsChecked="True" GroupName="UpdatePkgGroup" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,16,0" VerticalAlignment="Center" />
                          <RadioButton Name="UpdatePkgLightweightRadio" Content="依赖 .NET 8 运行时轻量版 (~2.7 MB)" GroupName="UpdatePkgGroup" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                      </Border>

                      <!-- 更新日志预览 -->
                      <TextBlock Text="📋 详细更新日志 (Changelog):" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,4,0,4" />
                      <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10">
                        <ScrollViewer MaxHeight="140" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                          <TextBlock Name="UpdateChangelogTextBlock" Text="" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" LineHeight="18" />
                        </ScrollViewer>
                      </Border>
                    </StackPanel>
                  </Border>

                  <!-- 状态区 B: 下载进度条 -->
