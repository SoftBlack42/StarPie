                                <TextBlock Name="RollbackDetailChannelText" Text="尝鲜测试版" FontSize="10" FontWeight="SemiBold" Foreground="#F59E0B" />
                              </Border>
                              <TextBlock Name="RollbackDetailDateText" Text="· 发布于 2026-09-08" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="8,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                              <TextBlock Text="安装包架构:" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,6,0" VerticalAlignment="Center" />
                              <TextBlock Name="RollbackInstallTypeText" Text="独立免安装版" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                            </StackPanel>
